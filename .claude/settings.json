{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(npm run clean)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Edit(/*.html)",
      "Edit(/static/js/**)",
      "Edit(/static/css/index.css)",
      "Edit(/sitemap.xml)",
      "Edit(/_redirects)",
      "Edit(/linkinator.config.json)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git mv *)",
      "Bash(rm *)",
      "Edit(/package.json)",
      "Edit(/robots.txt)",
      "Edit(**/*.md)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npx *)",
      "Bash(npm run dev)",
      "Bash(npm run serve)",
      "Edit(/AGENTS.md)",
      "Edit(/DESIGN.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/CLAUDE.local.md)",
      "Edit(/.claude/**)",
      "Edit(/docs/**)",
      "Edit(**/*.log)",
      "Edit(/static/css/tailwind.css)",
      "Edit(/package-lock.json)",
      "Edit(/functions/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}