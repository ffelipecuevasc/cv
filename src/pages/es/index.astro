---
// Portada de /es/ (E40-I01 y E40-I02: hero, franja de cifras y testimonios);
// título y descripción vienen de src/content/pages/home.json (provisorios hasta E40-I03).
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import StatsBand from '../../components/home/StatsBand.astro';
import Testimonials from '../../components/home/Testimonials.astro';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Falta src/content/pages/home.json');
const { title, description } = page.data;
---

<BaseLayout title={title.es} description={description.es} route="home">
  <Hero />
  <StatsBand />
  <Testimonials />
</BaseLayout>
