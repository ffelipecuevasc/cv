---
// Página Docente de /en/ (E80-I01, ADR-070). Título, descripción y texto alternativo de la
// imagen OG vienen de src/content/pages/lecturer.json; el contenido, de
// src/content/lecturer/page.json.
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LecturerHeader from '../../components/lecturer/LecturerHeader.astro';
import CoursesGrid from '../../components/lecturer/CoursesGrid.astro';
import InstitutionsZigzag from '../../components/lecturer/InstitutionsZigzag.astro';
import MentoringBand from '../../components/lecturer/MentoringBand.astro';
import SpecialRoles from '../../components/lecturer/SpecialRoles.astro';
import { getHomeOgImage } from '../../components/seo/home-og-image';

const page = await getEntry('pages', 'lecturer');
if (!page) throw new Error('Falta src/content/pages/lecturer.json');
const { title, description, ogImageAlt } = page.data;
const og = { ...(await getHomeOgImage()), alt: ogImageAlt?.en ?? title.en };
---

<BaseLayout title={title.en} description={description.en} route="lecturer" ogImage={og}>
  <LecturerHeader />
  <CoursesGrid />
  <InstitutionsZigzag />
  <MentoringBand />
  <SpecialRoles />
</BaseLayout>
