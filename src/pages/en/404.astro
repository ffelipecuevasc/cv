---
// 404 de /en/ (E160-I01, ADR-088, composición A). noindex, follow y fuera del sitemap (ruta
// interna). Astro la genera como dist/en/404/index.html y `scripts/place-404.mjs` (ADR-089) la deja como
// dist/en/404.html, el nombre que Cloudflare busca para las rutas inexistentes de /en/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFound from '../../components/not-found/NotFound.astro';
import { getHomeOgImage } from '../../components/seo/home-og-image';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('en');
const og = { ...(await getHomeOgImage()), alt: t.notFound.ogImageAlt };
---

<BaseLayout
  title={t.notFound.metaTitle}
  description={t.notFound.metaDescription}
  route="notFound"
  ogImage={og}
  noindex
  follow
  mainClass="flex flex-col"
>
  <NotFound />
</BaseLayout>
