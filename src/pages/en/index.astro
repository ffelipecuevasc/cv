---
// Portada mínima de /en/ (E10-I07, E30-I01). El contenido llega en E40; título y
// descripción vienen de src/content/pages/home.json (provisorios hasta E40-I03).
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Falta src/content/pages/home.json');
const { title, description } = page.data;
---

<BaseLayout title={title.en} description={description.en} route="home">
  <h1>Felipe Cuevas</h1>
</BaseLayout>
