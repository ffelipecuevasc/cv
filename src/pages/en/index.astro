---
// Portada de /en/ (E40-I01: hero). La banda de cifras y los testimonios llegan en E40-I02;
// título y descripción vienen de src/content/pages/home.json (provisorios hasta E40-I03).
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Falta src/content/pages/home.json');
const { title, description } = page.data;
---

<BaseLayout title={title.en} description={description.en} route="home">
  <Hero />
</BaseLayout>
