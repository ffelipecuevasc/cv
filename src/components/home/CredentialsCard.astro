---
/*
 * Tarjeta de certificaciones del hero (E40-I01, DESIGN.md 7.4, ADR-054): rótulo y las 4
 * insignias de los emisores (Oracle, AWS, Python Institute y Anthropic) de 40 px con su
 * nombre. Desde 640 px flota sobre la esquina inferior izquierda del retrato, corrida 32 px
 * hacia fuera, con las insignias en 2 × 2 (en una fila no caben sin tapar el riel social);
 * bajo 640 px va estática debajo del retrato, en una fila.
 * Las insignias se cargan con prioridad normal (están sobre el pliegue, AT-013) y se sirven
 * en WebP a 40 px (y 80 px para pantallas densas) desde las fuentes de src/assets/insignias/.
 * Son decorativas (alt vacío): el nombre del emisor está al lado, en texto.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import oracle from '../../assets/insignias/insignia_oracle.png';
import aws from '../../assets/insignias/insignia_aws.png';
import pythonInstitute from '../../assets/insignias/insignia_python.png';
import anthropic from '../../assets/insignias/insignia_anthropic.png';
import type { CertificationIssuer } from '../../data/certifications';

interface Props {
  title: string;
  label: string;
}
const { title, label } = Astro.props;

// Nombres propios de los emisores: no se traducen (ADR-025).
const issuers: { id: CertificationIssuer; name: string; badge: ImageMetadata }[] = [
  { id: 'oracle', name: 'Oracle', badge: oracle },
  { id: 'aws', name: 'AWS', badge: aws },
  { id: 'python-institute', name: 'Python Institute', badge: pythonInstitute },
  { id: 'anthropic', name: 'Anthropic', badge: anthropic },
];
---

<div class="credentials" role="group" aria-labelledby="hero-credentials-title">
  <p class="title" id="hero-credentials-title">
    {title}
  </p>
  <ul aria-label={label}>
    {issuers.map((issuer) => (
      <li>
        <Image
          src={issuer.badge}
          alt=""
          width={40}
          height={40}
          densities={[1, 2]}
          loading="eager"
          decoding="async"
        />
        <span class="name">{issuer.name}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .credentials {
    margin-top: 24px;
    padding: 20px 24px;
    background-color: var(--color-surface);
    border-top: 2px solid var(--color-vibrant);
    box-shadow: var(--shadow-float);
  }
  @media (min-width: 40rem) {
    .credentials {
      position: absolute;
      bottom: 24px;
      left: -32px;
      z-index: 1;
      margin-top: 0;
    }
  }
  .title {
    color: var(--color-kicker);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }
  img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .name {
    color: var(--color-text);
    font-size: 13px;
    line-height: 1.3;
  }
  @media (min-width: 40rem) {
    ul {
      grid-template-columns: repeat(2, 112px);
      gap: 14px 16px;
    }
    .name {
      font-size: 14px;
    }
  }
</style>
