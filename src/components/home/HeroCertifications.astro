---
/*
 * Certificaciones del hero (E40-I04, DESIGN.md 7.4, ADR-054 y ADR-058): rótulo "Profesional
 * certificado" y las 4 insignias de los emisores (Oracle, AWS, Python y Anthropic) de 40 px,
 * con su nombre al lado, sin contenedor. Van bajo el párrafo, iguales en los tres perfiles.
 * En una fila desde 640 px; bajo esa medida, en 2 × 2.
 * Las insignias se cargan con prioridad normal (están sobre el pliegue, AT-013) y se sirven
 * en WebP a 40 px (y 80 px para pantallas densas) desde src/assets/insignias/. Son
 * decorativas (alt vacío): el nombre del emisor está al lado, en texto.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import oracle from '../../assets/insignias/insignia_oracle.png';
import aws from '../../assets/insignias/insignia_aws.png';
import python from '../../assets/insignias/insignia_python.png';
import anthropic from '../../assets/insignias/insignia_anthropic.png';

interface Props {
  title: string;
  label: string;
}
const { title, label } = Astro.props;

// Nombres propios: no se traducen (ADR-025). "Python" abrevia a "Python Institute", cuyo
// nombre completo va en Educación y en el JSON-LD (ADR-058).
const issuers: { name: string; badge: ImageMetadata }[] = [
  { name: 'Oracle', badge: oracle },
  { name: 'AWS', badge: aws },
  { name: 'Python', badge: python },
  { name: 'Anthropic', badge: anthropic },
];
---

<div class="credentials" role="group" aria-labelledby="hero-credentials-title">
  <p class="title" id="hero-credentials-title">
    {title}
  </p>
  <ul aria-label={label}>
    {issuers.map((issuer) => (
      <li>
        <Image
          src={issuer.badge}
          alt=""
          width={40}
          height={40}
          densities={[1, 2]}
          loading="eager"
          decoding="async"
        />
        <span class="name">{issuer.name}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Separación con el párrafo: 32 px (escala de 6, la fija E40-I04). */
  .credentials {
    margin-top: 32px;
  }
  .title {
    color: var(--color-kicker);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 24px;
    margin-top: 16px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  img {
    flex: none;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .name {
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.3;
  }
  @media (min-width: 40rem) {
    ul {
      display: flex;
      flex-wrap: wrap;
      gap: 16px 28px;
    }
  }
</style>
