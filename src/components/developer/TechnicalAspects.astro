---
/*
 * Aspectos técnicos (E70-I01, ADR-067): patrón «lista a dos columnas con regla superior»
 * (DESIGN.md 11.2, reservado y aprobado por Felipe para Desarrollador). Cuatro entradas con
 * ícono de Material Symbols Light (ADR-063), h3 y texto con énfasis. Una columna bajo 768 px y
 * dos desde 768 px. Sin JavaScript. Fondo `bg`. Dentro de <main>.
 */
import { getEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { parseEmphasis } from '../home/hero-text';
import { langFromLocale } from '../../i18n/lang';

const lang = langFromLocale(Astro.currentLocale);
const page = (await getEntry('developerPage', 'page'))?.data;
if (!page) throw new Error('Falta src/content/developer/page.json');
const { aspects } = page;
---

<section class="aspects" aria-labelledby="aspects-title">
  <Container>
    <SectionHeader
      kicker={aspects.kicker[lang]}
      title={aspects.title[lang]}
      lead={aspects.lead[lang]}
      id="aspects-title"
    />
    <ul class="list" data-aspects>
      {aspects.items.map((item) => (
        <li class="item">
          <span class="icon">
            <Icon name={item.icon} size={32} />
          </span>
          <div>
            <h3 class="item-title">{item.title[lang]}</h3>
            <p class="text">
              {parseEmphasis(item.text[lang]).map((part) =>
                part.strong ? <strong>{part.text}</strong> : part.text,
              )}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </Container>
</section>

<style>
  /* Relleno vertical de sección: 56 px abajo bajo 768 px y 96 px desde 768 px (DESIGN.md 6). */
  .aspects {
    padding-block: 32px 72px;
    background-color: var(--color-bg);
  }
  .list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  /* Regla superior de 1 px con un tramo dorado corto al inicio (DESIGN.md 7.5). */
  .item {
    position: relative;
    display: flex;
    gap: 20px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border-strong);
  }
  .item::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-gold), var(--color-vibrant));
  }
  .icon {
    flex: none;
    color: var(--color-icon);
  }
  .item-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .text {
    margin: 10px 0 0;
    color: var(--color-text-muted);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.65;
  }
  .text strong {
    color: var(--color-text);
    font-weight: 600;
  }
  @media (min-width: 48rem) {
    .aspects {
      padding-block: 40px 96px;
    }
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 56px;
    }
  }
</style>
