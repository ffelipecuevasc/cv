---
/*
 * Muro de tecnologías (E70-I01, ADR-067): una banda de ancho completo (DESIGN.md 7.8) con las
 * 36 tecnologías de main:desarrollador.html en sus 5 categorías, apiladas. Cada categoría lleva
 * un h3 con estilo kicker y su retícula de fichas (2, 3, 4 o 6 columnas según el ancho).
 * Los SVG de marca se copiaron sin cambios de main:static/img/iconos/ a
 * src/assets/technologies/ (DESIGN.md 7.14): van como <img> decorativos (el nombre está en el
 * texto), con ancho y alto declarados y carga diferida. En oscuro van sobre una placa clara
 * (`--tech-plate-bg`, ADR-069). Sin JavaScript. Dentro de <main>.
 */
import { getEntry } from 'astro:content';
import Band from '../ui/Band.astro';
import { langFromLocale } from '../../i18n/lang';

const lang = langFromLocale(Astro.currentLocale);
const page = (await getEntry('developerPage', 'page'))?.data;
if (!page) throw new Error('Falta src/content/developer/page.json');
const { technologies } = page;

const files = import.meta.glob<string>('../../assets/technologies/*.svg', {
  eager: true,
  query: '?no-inline',
  import: 'default',
});
const iconUrl = (icon: string): string => {
  const url = files[`../../assets/technologies/${icon}.svg`];
  if (!url) throw new Error(`Falta src/assets/technologies/${icon}.svg`);
  return url;
};
---

<Band
  id="technologies"
  kicker={technologies.kicker[lang]}
  title={technologies.title[lang]}
  lead={technologies.lead[lang]}
>
  <div class="wall" data-technologies>
    {technologies.categories.map((category) => (
      <div class="category">
        <h3 class="category-title" id={`tech-${category.id}`}>
          {category.title[lang]}
        </h3>
        <ul class="grid" aria-labelledby={`tech-${category.id}`}>
          {category.items.map((tech) => (
            <li class="tile" data-tech={tech.icon}>
              <span class="logo">
                <img
                  src={iconUrl(tech.icon)}
                  alt=""
                  width="28"
                  height="28"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="label">
                <span class="name">{tech.name}</span>
                <span class="role">{tech.role[lang]}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Band>

<style>
  .wall {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .category-title {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0;
    color: var(--color-kicker);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  /* Regla dorada de 32 px antes del rótulo (DESIGN.md 7.5), decorativa. */
  .category-title::before {
    content: '';
    flex: none;
    width: 32px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-gold), var(--color-vibrant));
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 12px;
    background-color: var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-border);
  }
  .logo {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    /* Placa clara en oscuro (ADR-069): los SVG de marca no cambian. */
    background-color: var(--tech-plate-bg);
    box-shadow: 0 0 0 1px var(--color-border);
  }
  .logo img {
    display: block;
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  .label {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .name {
    color: var(--color-text);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .role {
    margin-top: 2px;
    color: var(--color-text-soft);
    font-size: 13px;
    line-height: 1.35;
  }
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 80rem) {
    .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
