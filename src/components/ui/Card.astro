---
/*
 * Tarjeta base (DESIGN.md 7.6): fondo surface, sin radio, línea superior gold → vibrant
 * inserta 34 px, sombra card. Al pasar el cursor sube 4 px (permitido por DESIGN.md 8).
 */
interface Props {
  as?: 'article' | 'li' | 'div' | 'figure';
  class?: string;
}
const { as: Tag = 'article', class: className } = Astro.props;
---

<Tag class:list={['card', className]}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    background-color: var(--color-surface);
    padding: 40px 34px 32px;
    box-shadow:
      0 0 0 1px var(--card-outline),
      var(--shadow-card);
    transition-property: translate, box-shadow;
    transition-duration: var(--duration-slow);
    transition-timing-function: var(--ease-out-soft);
  }
  .card::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 34px;
    height: 2px;
    background-image: linear-gradient(90deg, var(--color-gold), var(--color-vibrant));
  }
  .card:hover {
    translate: 0 -4px;
    box-shadow:
      0 0 0 1px var(--card-outline-hover),
      var(--shadow-card-hover);
  }
</style>
