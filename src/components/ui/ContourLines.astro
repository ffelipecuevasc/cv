---

<div class:list={['contour-lines', `mask-${mask}`, className]} aria-hidden="true">
  {pieces.map(({ corner, shape = 'a' }) => (
    <svg
      class:list={['piece', corner, `shape-${shape}`]}
      viewBox={`0 0 ${SIZES[shape].width} ${SIZES[shape].height}`}
      width={SIZES[shape].width}
      height={SIZES[shape].height}
      focusable="false"
      aria-hidden="true"
    >
      <path class="line" d={SHAPES[shape].line} />
      <path class="accent" d={SHAPES[shape].accent} />
    </svg>
  ))}
</div>

<style>
  .contour-lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .mask-center {
    mask-image: radial-gradient(ellipse at 50% 50%, transparent 45%, black 95%);
  }
  /* Bajo 640 px la banda es alta y el texto llega casi a las esquinas: se despeja más el centro
     para que text-soft no baje de 4,5:1 donde lo cruza una curva (medido en E200-I05). */
  @media (max-width: 39.999rem) {
    .mask-center {
      mask-image: radial-gradient(ellipse at 50% 50%, transparent 55%, black 100%);
    }
  }
  .piece {
    position: absolute;
    overflow: hidden;
    /* Cada pieza se desvanece desde su esquina, para que las curvas no se corten en seco en el
       borde del lienzo. La máscara se refleja junto con la pieza. */
    mask-image: radial-gradient(circle 340px at 0 100%, black 45%, transparent 100%);
  }
  path {
    fill: none;
    stroke-width: 0.85;
    vector-effect: non-scaling-stroke;
  }
  .line {
    stroke: var(--contour-line);
  }
  .accent {
    stroke: var(--contour-accent);
  }
  .bottom-left {
    inset-block-end: 0;
    inset-inline-start: 0;
  }
  .top-right {
    inset-block-start: 0;
    inset-inline-end: 0;
    transform: scale(-1, -1);
  }
  .top-left {
    inset-block-start: 0;
    inset-inline-start: 0;
    transform: scaleY(-1);
  }
  .bottom-right {
    inset-block-end: 0;
    inset-inline-end: 0;
    transform: scaleX(-1);
  }
  .center-right {
    inset-block-start: 50%;
    inset-inline-end: 0;
    transform: translateY(-50%);
  }
  /* hill: se desvanece hacia la izquierda desde el borde derecho. Mientras el contenido llega
     cerca del borde (bajo 1.792 px), solo asoma una franja junto a él, para que text-soft de las
     insignias mantenga 4,5:1 donde lo cruza una curva (medido en E200-I06). */
  .shape-hill {
    mask-image: radial-gradient(ellipse 150px 300px at 100% 50%, black 25%, transparent 100%);
  }
  @media (max-width: 47.999rem) {
    .shape-hill {
      mask-image: radial-gradient(ellipse 90px 300px at 100% 50%, black 20%, transparent 100%);
    }
  }
  @media (max-width: 29.999rem) {
    .shape-hill {
      mask-image: radial-gradient(ellipse 56px 260px at 100% 50%, black 15%, transparent 100%);
    }
  }
  @media (min-width: 112rem) {
    .shape-hill {
      mask-image: radial-gradient(ellipse 440px 330px at 100% 50%, black 40%, transparent 100%);
    }
  }
  /* range: se desvanece hacia la derecha y hacia arriba desde la esquina inferior izquierda. Bajo
     1.024 px la franja se apila y las insignias llegan al borde inferior: la pieza se achata. */
  .shape-range {
    mask-image: radial-gradient(ellipse 820px 300px at 0 100%, black 30%, transparent 100%);
  }
  @media (max-width: 63.999rem) {
    .shape-range {
      mask-image: radial-gradient(ellipse 560px 120px at 0 100%, black 25%, transparent 100%);
    }
  }
  /* summit: centrada arriba. La curva interna rodea el encabezado de la banda (texto hasta
     ±252 px y 243 px de alto) sin cruzarlo, y todo se desvanece antes de la grilla (296 px).
     Bajo 640 px el encabezado es más alto: la pieza baja 40 px y se desvanece más tarde. */
  .top-center {
    inset-block-start: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
  }
  .shape-summit {
    mask-image: linear-gradient(to bottom, black 0, black 200px, transparent 290px);
  }
  @media (max-width: 39.999rem) {
    .shape-summit {
      inset-block-start: 40px;
      mask-image: linear-gradient(to bottom, black 0, black 220px, transparent 296px);
    }
  }
  /* slope: se dibuja para bottom-left y top-left la refleja, así que la máscara se escribe en
     esas coordenadas (0 100 % es la esquina superior izquierda en pantalla). Sus radios siguen el
     margen libre del contenedor: la ladera ocupa el margen izquierdo y la franja sobre el texto,
     y se desvanece antes de él (medido en E200-I09). */
  .shape-slope {
    mask-image: radial-gradient(
      ellipse max(140px, calc(50vw - 520px)) clamp(90px, calc(50vw - 640px), 300px) at 0 100%,
      black 30%,
      transparent 100%
    );
  }
  @media (max-width: 47.999rem) {
    .shape-slope {
      mask-image: radial-gradient(ellipse 140px 64px at 0 100%, black 30%, transparent 100%);
    }
  }
  /* mound: centrada abajo; asoma en la franja libre bajo el contenido de la banda. */
  .bottom-center {
    inset-block-end: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
  }
  .shape-mound {
    mask-image: linear-gradient(to top, black 0, black 16px, transparent 52px);
  }
  /* valley: un flanco por lado, centrado en vertical; el derecho es el reflejo del izquierdo.
     La máscara va del borde hacia adentro y se apaga antes del texto de la banda (margen libre
     de 171 px a 1.366 y de 448 px a 1.920, medido en E200-I10). Bajo 768 px el margen es de 16 px
     y la máscara alcanzaría el botón y el texto del certificado: la pieza no se dibuja. */
  .middle-left {
    inset-block-start: 50%;
    inset-inline-start: 0;
    transform: translateY(-50%);
  }
  .middle-right {
    inset-block-start: 50%;
    inset-inline-end: 0;
    transform: translateY(-50%) scaleX(-1);
  }
  .shape-valley {
    mask-image: linear-gradient(
      to right,
      black 0,
      black calc(max(32px, 50vw - 520px) * 0.35),
      transparent max(32px, 50vw - 520px)
    );
  }
  @media (max-width: 47.999rem) {
    .shape-valley {
      display: none;
    }
  }
</style>
