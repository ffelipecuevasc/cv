<div class:list={['contour-lines', `mask-${mask}`, className]} aria-hidden="true">
  {pieces.map(({ corner, shape = 'a' }) => (
    <svg
      class:list={['piece', corner, `shape-${shape}`]}
      viewBox={`0 0 ${SIZES[shape].width} ${SIZES[shape].height}`}
      width={SIZES[shape].width}
      height={SIZES[shape].height}
      focusable="false"
      aria-hidden="true"
    >
      <path class="line" d={SHAPES[shape].line} />
      <path class="accent" d={SHAPES[shape].accent} />
    </svg>
  ))}
</div>

<style>
  .contour-lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .mask-center {
    mask-image: radial-gradient(ellipse at 50% 50%, transparent 45%, black 95%);
  }
  /* Bajo 640 px la banda es alta y el texto llega casi a las esquinas: se despeja más el centro
     para que text-soft no baje de 4,5:1 donde lo cruza una curva (medido en E200-I05). */
  @media (max-width: 39.999rem) {
    .mask-center {
      mask-image: radial-gradient(ellipse at 50% 50%, transparent 55%, black 100%);
    }
  }
  .piece {
    position: absolute;
    overflow: hidden;
    /* Cada pieza se desvanece desde su esquina, para que las curvas no se corten en seco en el
       borde del lienzo. La máscara se refleja junto con la pieza. */
    mask-image: radial-gradient(circle 340px at 0 100%, black 45%, transparent 100%);
  }
  path {
    fill: none;
    stroke-width: 0.85;
    vector-effect: non-scaling-stroke;
  }
  .line {
    stroke: var(--contour-line);
  }
  .accent {
    stroke: var(--contour-accent);
  }
  .bottom-left {
    inset-block-end: 0;
    inset-inline-start: 0;
  }
  .top-right {
    inset-block-start: 0;
    inset-inline-end: 0;
    transform: scale(-1, -1);
  }
  .top-left {
    inset-block-start: 0;
    inset-inline-start: 0;
    transform: scaleY(-1);
  }
  .bottom-right {
    inset-block-end: 0;
    inset-inline-end: 0;
    transform: scaleX(-1);
  }
  .center-right {
    inset-block-start: 50%;
    inset-inline-end: 0;
    transform: translateY(-50%);
  }
  /* hill: se desvanece hacia la izquierda desde el borde derecho. Mientras el contenido llega
     cerca del borde (bajo 1.792 px), solo asoma una franja junto a él, para que text-soft de las
     insignias mantenga 4,5:1 donde lo cruza una curva (medido en E200-I06). */
  .shape-hill {
    mask-image: radial-gradient(ellipse 150px 300px at 100% 50%, black 25%, transparent 100%);
  }
  @media (max-width: 47.999rem) {
