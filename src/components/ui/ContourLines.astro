    accent:
      'M170 294C173 272 153 237 136 220C119 203 91 194 68 189C46 185 21 185 1 192C-19 199 -37 216 -50 233C-64 250 -76 270 -81 294C-86 318 -92 357 -79 376C-66 395 -27 409 -3 409C20 409 41 387 61 378C81 369 100 369 118 355C136 341 167 316 170 294ZM307 294C313 249 271 182 237 147C202 112 147 92 103 83C58 74 8 77 -32 92C-71 106 -109 137 -136 171C-163 204 -185 246 -195 294C-204 342 -218 421 -193 459C-167 497 -87 522 -40 523C7 523 49 481 89 463C129 445 164 443 200 415C236 386 301 339 307 294Z',
