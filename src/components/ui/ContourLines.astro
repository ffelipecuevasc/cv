    accent:
      'M158 282C157 259 133 228 115 214C97 200 71 202 50 197C29 191 13 182 -10 182C-34 182 -78 182 -93 198C-108 215 -107 258 -102 282C-97 306 -77 326 -62 343C-46 359 -30 373 -10 381C10 388 36 395 57 390C78 385 100 369 117 351C134 333 158 305 158 282ZM298 282C298 237 241 178 205 149C168 120 120 117 79 107C38 97 7 86 -41 87C-90 87 -182 80 -212 112C-242 145 -232 233 -221 282C-211 331 -179 374 -149 406C-119 438 -81 458 -41 475C0 491 52 512 94 502C135 493 175 454 209 418C243 381 299 327 298 282Z',
  },
