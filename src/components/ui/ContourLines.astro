---
/*
 * Curvas de nivel decorativas (E200-I05, ADR-113; DESIGN.md 4.5). Capa reutilizable que recibe la
 * composición: cada pieza es un grupo de curvas cerradas y concéntricas (Bézier suaves, 12 por
 * grupo, separadas unos 23 px, cada quinta en dorado) anclado a una esquina con ancho fijo, para
 * que no se deforme cuando la banda cambia de alto. Una máscara radial despeja el centro.
 * Sin JavaScript: SVG en línea, aria-hidden, focusable="false" y sin eventos de puntero.
 * Los trazos se generaron una vez (Catmull-Rom → Bézier cúbica) y se versiona solo el resultado.
 * Las formas a y b se dibujan para la esquina inferior izquierda; las demás esquinas las reflejan.
 * E200-I06 suma dos formas con lienzo propio para las franjas de Educación: hill (relieve con el
 * centro fuera del borde derecho, anclado en center-right) y range (cordillera horizontal anclada
 * en bottom-left que se desvanece a la derecha).
 * E200-I08 suma summit para la banda de tecnologías de Desarrollador: 13 curvas abiertas en U
 * (superelipses) que cuelgan del borde superior, centradas (top-center), con el encabezado de la
 * banda dentro de la curva interna y desvanecidas antes de la grilla.
 * E200-I09 suma dos formas para Docente: slope (ladera de terrazas abiertas que baja en diagonal
 * desde la esquina superior izquierda, franja de Duoc UC; se dibuja para bottom-left y top-left la
 * refleja) y mound (loma de arcos de elipse que sube desde el borde inferior, anclada en
 * bottom-center, banda «Tutor de Alumnos»). Ambas se ven en los márgenes libres de texto.
 * E200-I10 suma valley para «Instructor Titular»: los dos flancos de un valle, 13 líneas abiertas,
 * casi verticales y paralelas, que recorren todo el alto por el borde izquierdo (middle-left) y,
 * en espejo, por el derecho (middle-right). Es la única composición de líneas paralelas de borde a
 * borde, sin centro: las demás son grupos concéntricos o arcos alrededor de un punto.
 * E200-I11 suma cuatro formas para Talento Digital, dibujadas ya en su orientación de pantalla
 * (sin reflejo): dunes (franja pf1487: 13 crestas onduladas, paralelas y de separación constante,
 * en diagonal desde la esquina superior derecha), twin (franja pf1164-2: relieve de dos cimas
 * pequeñas con su collado, en la esquina inferior derecha), ravine (franja pf1163: quebrada de 13 V
 * abiertas al borde izquierdo, con la punta aguas arriba, en la mitad inferior) y spurs (banda de
 * cifras: espolones, curvas abiertas con dos lóbulos que apuntan al centro, en las esquinas
 * superior izquierda e inferior derecha). Su posición y sus máscaras viven en BootcampsZigzag y en
 * Achievements: aquí harían pasar esta hoja del límite para insertarse en el HTML (AT-165) en
 * todas las páginas con curvas.
 */

type Corner =
  | 'bottom-left'
  | 'top-right'
  | 'top-left'
  | 'bottom-right'
  | 'center-right'
  | 'top-center'
  | 'bottom-center'
  | 'middle-left'
  | 'middle-right';
type Shape =
  | 'a'
  | 'b'
  | 'hill'
  | 'range'
  | 'summit'
  | 'slope'
  | 'mound'
  | 'valley'
  | 'dunes'
  | 'twin'
  | 'ravine'
  | 'spurs';

export interface ContourPiece {
  corner: Corner;
  shape?: Shape;
}

interface Props {
  pieces: ContourPiece[];
  /** Máscara radial: 'center' despeja el centro (Inicio); 'none' deja solo la de cada pieza. */
  mask?: 'center' | 'none';
  class?: string;
}

const { pieces, mask = 'center', class: className } = Astro.props;

