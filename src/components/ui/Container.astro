---
/* Contenedor centrado de 1.280 px con márgenes laterales de 16 / 40 px y zona segura (DESIGN.md 6). */
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
}
const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container-page', className]}>
  <slot />
</Tag>

<style>
  .container-page {
    margin-inline: auto;
    max-width: var(--container-page);
    padding-inline: max(1rem, env(safe-area-inset-left)) max(1rem, env(safe-area-inset-right));
  }
  @media (min-width: 48rem) {
    .container-page {
      padding-inline: max(2.5rem, env(safe-area-inset-left)) max(2.5rem, env(safe-area-inset-right));
    }
  }
</style>
