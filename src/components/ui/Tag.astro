---
/* Etiqueta (chip) de DESIGN.md 7.7: contorno 1 px, sin radio, Josefin 400 13 px en mayúsculas. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['tag', className]}>
  <slot />
</span>

<style>
  .tag {
    display: inline-block;
    border: 1px solid var(--chip-border);
    background-color: var(--chip-bg);
    color: var(--chip-fg);
    padding: 6px 12px;
    font-size: 13px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
