---
/*
 * Franja temática (DESIGN.md 7.8, ADR-036): ancho completo, título de la categoría y
 * contenido. `reverse` cambia la orientación solo con CSS: el HTML siempre va título →
 * contenido, así que el orden de lectura no cambia. Fondo band o bg. Una columna bajo 1.024 px.
 */
import Container from './Container.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  kicker: string;
  title: string;
  lead?: string;
  id: string;
  reverse?: boolean;
  tone?: 'band' | 'bg';
  /** Nivel del titular (ADR-005): 3 si la franja vive bajo un <h2> de sección. */
  level?: 2 | 3;
  /** Con `reverse`, alinea rótulo, titular y barra a la derecha desde 1.024 px (espejo de la franja anterior). */
  mirror?: boolean;
  /**
   * Suma la bajada al nombre accesible de la franja. Sirve cuando dos franjas comparten titular
   * (Talento Digital: dos ejecuciones de Python y dos de JavaScript, E100-I01).
   */
  labelWithLead?: boolean;
}
const {
  kicker,
  title,
  lead,
  id,
  reverse = false,
  tone = 'band',
  level = 2,
  mirror = false,
  labelWithLead = false,
} = Astro.props;
const labelledBy = labelWithLead && lead ? `${id}-title ${id}-lead` : `${id}-title`;
---

<section
  id={id}
  aria-labelledby={labelledBy}
  class:list={['stripe', tone === 'band' ? 'texture-band' : 'tone-bg', { reverse }]}
>
  <Container class="stripe-grid">
    <div class="stripe-title">
      <SectionHeader
        kicker={kicker}
        title={title}
        lead={lead}
        level={level}
        id={`${id}-title`}
        align={mirror ? 'end-lg' : 'start'}
        leadId={labelWithLead ? `${id}-lead` : undefined}
      />
    </div>
    <div class="stripe-content">
      <slot />
    </div>
  </Container>
</section>

<style>
  .stripe {
    padding-block: 56px;
  }
  .tone-bg {
    background-color: var(--color-bg);
  }
  .stripe :global(.stripe-grid) {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 48rem) {
    .stripe {
      padding-block: 64px;
    }
  }
  @media (min-width: 64rem) {
    .stripe :global(.stripe-grid) {
      grid-template-columns: 5fr 7fr;
      align-items: center;
      gap: 48px;
    }
    .reverse :global(.stripe-grid) {
      grid-template-columns: 7fr 5fr;
    }
    .reverse .stripe-title {
      grid-column: 2;
      grid-row: 1;
    }
    .reverse .stripe-content {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>
