---
/*
 * Temáticas de la bóveda (E130-I02, ADR-081): grilla simétrica de tarjetas (DESIGN.md 11.2)
 * sobre `bg-alt`, un h3 por temática y sus recursos en tarjetas `surface` con h4, chips,
 * descripción y enlace. Sin progreso ni JavaScript: todo se lee tal cual.
 */
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ResourceAction from './ResourceAction.astro';
import ResourceChips from './ResourceChips.astro';
import { langFromLocale } from '../../i18n/lang';
import { getThemes } from './resources-data';

const lang = langFromLocale(Astro.currentLocale);
const themes = await getThemes();
---

<section class="themes" aria-labelledby="themes-title">
  <Container>
    <SectionHeader
      kicker={themes.kicker[lang]}
      title={themes.title[lang]}
      lead={themes.lead[lang]}
      id="themes-title"
    />
    {themes.groups.map((group) => (
      <div class="group" data-theme={group.id}>
        <h3 class="group-title" id={`theme-${group.id}`}>
          {group.title[lang]}
          <span class="count" aria-hidden="true">
            {group.items.length}
          </span>
        </h3>
        <ul class="grid" aria-labelledby={`theme-${group.id}`}>
          {group.items.map((item) => (
            <li class="card" data-resource={item.id}>
              <ResourceChips resource={item} {lang} />
              <h4 class="card-title">{item.title[lang]}</h4>
              <p class="text">{item.description[lang]}</p>
              <ResourceAction resource={item} {lang} />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </Container>
</section>

<style>
  .themes {
    padding-block: 80px;
    background-color: var(--color-bg-alt);
  }
  .group {
    margin-top: 48px;
  }
  .group-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .count {
    color: var(--color-text-soft);
    font-family: var(--font-sans);
    font-size: 13px;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .card-title {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.35;
  }
  .text {
    flex: 1;
    margin: 8px 0 0;
    color: var(--color-text-muted);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
  }
  @media (min-width: 48rem) {
    .themes {
      padding-block: 96px;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }
</style>
