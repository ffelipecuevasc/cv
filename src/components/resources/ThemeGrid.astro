---
/*
 * Temáticas de la bóveda (E130-I02, ADR-081): grilla simétrica de tarjetas (DESIGN.md 11.2)
 * sobre `bg-alt`, un h3 por temática y sus recursos en tarjetas `surface` con h4, chips,
 * descripción y enlace. Sin progreso ni JavaScript: todo se lee tal cual.
 * E200-I14b (ADR-122, opción 1): cada encabezado lleva el logo oficial de la temática a la izquierda
 * (decorativo; SVG de src/assets/technologies/ o ícono de marca), el nombre y, a la derecha, la
 * cantidad en texto discreto, sin insignia. En oscuro el logo va sobre la placa clara (ADR-069).
 */
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ResourceAction from './ResourceAction.astro';
import ResourceChips from './ResourceChips.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';
import { langFromLocale } from '../../i18n/lang';
import { getThemes } from './resources-data';

const lang = langFromLocale(Astro.currentLocale);
const themes = await getThemes();

const files = import.meta.glob<string>('../../assets/technologies/*.svg', {
  eager: true,
  query: '?no-inline',
  import: 'default',
});
const logoUrl = (logo: string) => files[`../../assets/technologies/${logo}.svg`];
const countText = (n: number) =>
  n === 1 ? themes.countOne[lang] : themes.count[lang].replace('{n}', String(n));
---

<section class="themes" aria-labelledby="themes-title">
  <Container>
    <SectionHeader
      kicker={themes.kicker[lang]}
      title={themes.title[lang]}
      lead={themes.lead[lang]}
      id="themes-title"
    />
    {themes.groups.map((group) => (
      <div class="group" data-theme={group.id}>
        <div class="group-head">
          <span class="logo" aria-hidden="true" data-theme-logo={group.logo}>
            {logoUrl(group.logo) ? (
              <img src={logoUrl(group.logo)} alt="" width="24" height="24" loading="lazy" />
            ) : (
              <Icon name={group.logo as IconName} size={24} />
            )}
          </span>
          <h3 class="group-title" id={`theme-${group.id}`}>
            {group.title[lang]}
          </h3>
          <p class="count" data-theme-count>
            {countText(group.items.length)}
          </p>
        </div>
        <ul class="grid" aria-labelledby={`theme-${group.id}`}>
          {group.items.map((item) => (
            <li class="card" data-resource={item.id}>
              <ResourceChips resource={item} {lang} />
              <h4 class="card-title">{item.title[lang]}</h4>
              <p class="text">{item.description[lang]}</p>
              <ResourceAction resource={item} {lang} />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </Container>
</section>

<style>
  .themes {
    padding-block: 80px;
    background-color: var(--color-bg-alt);
  }
  .group {
    margin-top: 48px;
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .logo {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    background-color: var(--tech-plate-bg);
    /* Ícono de marca en currentColor: tono oscuro de la paleta, legible sobre la placa clara. */
    color: var(--color-orient-600);
  }
  .logo img {
    display: block;
  }
  .group-title {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .count {
    margin: 0;
    color: var(--color-text-soft);
    font-family: var(--font-sans);
    font-size: 13px;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .card-title {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .text {
    flex: 1;
    margin: 8px 0 0;
    color: var(--color-text-muted);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.7;
  }
  @media (min-width: 48rem) {
    .themes {
      padding-block: 96px;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }
</style>
