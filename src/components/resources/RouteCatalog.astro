---
/*
 * Catálogo de rutas de aprendizaje de Recursos (E200-I14, ADR-122; alternativa A, «Catálogo de
 * rutas»). Banda (DESIGN.md 7.8) con curvas de nivel en collado (`saddle`) en lugar de la retícula y
 * una tarjeta por ruta de page.json: título (h3), resumen, duración y conocimientos previos,
 * número de etapas y pasos, progreso y enlace a la página de la ruta. Al final, un espacio indica
 * dónde aparecerán las próximas rutas.
 * - El progreso de cada tarjeta lo lee src/scripts/resources.ts de `rutas-progreso` (ADR-023):
 *   lleva `data-js-only` (sin CLS) y, con avance, el enlace pasa a «Continuar la ruta». Sin JavaScript, la tarjeta y
 *   su enlace funcionan igual.
 * - La máscara de las curvas vive aquí, no en ContourLines (AT-165).
 */
import Band from '../ui/Band.astro';
import ContourLines from '../ui/ContourLines.astro';
import Icon from '../ui/Icon.astro';
import { langFromLocale } from '../../i18n/lang';
import { getRoute, learningPathKey } from '../../i18n/routes';
import { fill, getResourcesPage, getRoutes } from './resources-data';

const lang = langFromLocale(Astro.currentLocale);
const { catalog, ui } = await getResourcesPage();
const routes = await getRoutes();
---

<Band id="routes" kicker={catalog.kicker[lang]} title={catalog.title[lang]} texture="contour">
  <ContourLines slot="decor" pieces={[{ corner: 'middle-left', shape: 'saddle' }]} mask="none" />
  <ul class="catalog" data-route-catalog>
    {routes.map(({ route, stages, total }) => {
      const href = getRoute(learningPathKey(route.id), lang);
      const titleId = `route-card-${route.id}`;
      return (
        <li
          class="card"
          data-route-card={route.id}
          data-steps={route.steps.join(' ')}
          data-progress-template={ui.progress[lang]}
          data-completed={ui.completed[lang]}
          data-continue={catalog.continue[lang]}
        >
          <p class="kicker">{ui.pathKicker[lang]}</p>
          <h3 class="title" id={titleId}>
            {route.title[lang]}
          </h3>
          <p class="summary">{route.summary[lang]}</p>
          <dl class="facts">
            {[route.facts[2], route.facts[1]].map((fact) => (
              <div class="fact">
                <dt>
                  <Icon name={fact.icon} size={18} />
                  {fact.label[lang]}
                </dt>
                <dd>{fact.text[lang]}</dd>
              </div>
            ))}
          </dl>
          <p class="count">{fill(catalog.count[lang], { stages: stages.length, steps: total })}</p>
          <div class="progress" data-card-progress data-js-only>
            <p class="progress-text" data-card-progress-text>
              {fill(ui.progress[lang], { done: 0, total })}
            </p>
            <div
              class="bar"
              role="progressbar"
              aria-label={ui.progressLabel[lang]}
              aria-valuemin="0"
              aria-valuemax={total}
              aria-valuenow="0"
              data-card-bar
            >
              <span class="bar-fill" data-card-fill></span>
            </div>
          </div>
          <a class="cta" href={href} aria-describedby={titleId} data-card-cta>
            <span data-card-cta-text>{catalog.start[lang]}</span>
            <Icon name="arrow-right" size={16} />
          </a>
        </li>
      );
    })}
    <li class="soon">
      <Icon name="more-horiz" size={24} />
      <p>{catalog.comingSoon[lang]}</p>
    </li>
  </ul>
</Band>

<script>
  import { initRouteCatalog } from '../../scripts/resources';

  initRouteCatalog();
</script>

<style>
  /* Collado (4.5, ADR-122): sin la máscara de esquina de la pieza. Se ve solo en el margen libre
     del contenedor, a la izquierda, y se apaga 20 px antes de las tarjetas. Bajo 1.024 px el
     margen es de 16 a 32 px y la pieza no se dibuja. */
  :global(#routes .shape-saddle) {
    mask-image: none;
  }
  :global(#routes .contour-lines) {
    --saddle-gutter: max(16px, 50vw - 600px);
    mask-image: linear-gradient(
      to right,
      black calc(var(--saddle-gutter) - 60px),
      transparent calc(var(--saddle-gutter) - 20px)
    );
  }
  @media (max-width: 63.999rem) {
    :global(#routes .contour-lines) {
      display: none;
    }
  }
  .catalog {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 28px 24px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .kicker {
    margin: 0;
    color: var(--color-kicker);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .title {
    margin: 8px 0 0;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .summary {
    margin: 12px 0 0;
    color: var(--color-text-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .facts {
    display: grid;
    gap: 16px;
    margin: 24px 0 0;
  }
  .fact {
    padding-top: 12px;
    border-top: 1px solid var(--color-border);
  }
  dt {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  dt :global(svg) {
    flex: none;
    color: var(--color-icon);
  }
  dd {
    margin: 6px 0 0;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.6;
  }
  .count {
    margin: 20px 0 0;
    color: var(--color-text-soft);
    font-size: 14px;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .progress {
    margin-top: 16px;
  }
  .progress-text {
    margin: 0;
    color: var(--color-text);
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .bar {
    height: 6px;
    margin-top: 10px;
    background-color: var(--color-border-strong);
  }
  .bar-fill {
    display: block;
    width: 0;
    height: 100%;
    background-image: linear-gradient(90deg, var(--color-gold), var(--color-vibrant));
  }
  .cta {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 10px;
    min-height: 46px;
    margin-top: 24px;
    padding-inline: 24px;
    background-color: var(--button-primary-bg);
    color: var(--button-primary-fg);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color var(--duration-base) ease;
  }
  .cta:hover {
    background-color: var(--color-accent);
  }
  .soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 160px;
    padding: 24px;
    border: 1px dashed var(--color-border-strong);
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.6;
    text-align: center;
  }
  .soon p {
    max-width: 28ch;
    margin: 0;
  }
  .soon :global(svg) {
    color: var(--color-icon);
  }
  @media (min-width: 48rem) {
    .card {
      padding: 32px;
    }
  }
  @media (min-width: 64rem) {
    .catalog {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
  }
</style>
