---
/*
 * Chips de un recurso (E130-I01, común desde E130-I02): formato con ícono en `icon`, dificultad
 * con 3 marcas en `accent` / `border-strong` más su nombre, y tecnología. Solo tokens (4.1).
 */
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';
import type { Resource } from './resources-data';
import { getResourcesPage } from './resources-data';

interface Props {
  resource: Resource;
  lang: 'es' | 'en';
}
const { resource, lang } = Astro.props;
const { ui } = await getResourcesPage();

const FORMAT_ICONS: Record<Resource['format'], IconName> = {
  pdf: 'pdf',
  video: 'play-circle',
  link: 'link',
  repo: 'github',
  template: 'description',
  article: 'description',
};
const LEVELS = { basic: 1, intermediate: 2, advanced: 3 } as const;
---

<p class="chips">
  <span class="chip format">
    <Icon name={FORMAT_ICONS[resource.format]} size={16} />
    {ui.formats[resource.format][lang]}
  </span>
  <span class="chip">
    <span class="levels" aria-hidden="true">
      {[1, 2, 3].map((n) => (
        <span class:list={['level', { on: n <= LEVELS[resource.difficulty] }]} />
      ))}
    </span>
    <span class="sr-only">{ui.difficultyLabel[lang]}: </span>
    {ui.difficulties[resource.difficulty][lang]}
  </span>
  <span class="chip">{resource.technology[lang]}</span>
</p>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    border: 1px solid var(--chip-border);
    background-color: var(--chip-bg);
    color: var(--chip-fg);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .format :global(svg) {
    color: var(--color-icon);
  }
  .levels {
    display: inline-flex;
    gap: 2px;
  }
  .level {
    width: 6px;
    height: 10px;
    background-color: var(--color-border-strong);
  }
  .level.on {
    background-color: var(--color-accent);
  }
</style>
