---
/*
 * Cabecera de la página de una ruta de aprendizaje (E200-I14, ADR-122; antes la ficha de la ruta
 * en Recursos, E130-I01). Enlace para volver a todas las rutas, el único <h1> (título de la ruta),
 * resumen, `dl` de 3 datos (qué logras, previos y duración) y el bloque de progreso.
 * El progreso solo existe con JavaScript (src/scripts/resources.ts): `data-js-only` lo oculta sin
 * JavaScript y lo reserva desde el primer pintado con él (sin CLS).
 */
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { langFromLocale } from '../../i18n/lang';
import { getRoute } from '../../i18n/routes';
import { fill, getResourcesPage, type RouteWithStages } from './resources-data';

interface Props {
  data: RouteWithStages;
}

const lang = langFromLocale(Astro.currentLocale);
const { route, total } = Astro.props.data;
const { ui } = await getResourcesPage();
---

<div class="route-header">
  <Container>
    <a class="back" href={`${getRoute('resources', lang)}#routes`} data-route-back>
      <Icon name="arrow-left" size={18} />
      {ui.back[lang]}
    </a>
    <SectionHeader
      level={1}
      kicker={ui.pathKicker[lang]}
      title={route.title[lang]}
      lead={route.summary[lang]}
      id="route-title"
    />
    <dl class="facts">
      {route.facts.map((fact) => (
        <div class="fact">
          <dt>
            <Icon name={fact.icon} size={20} />
            {fact.label[lang]}
          </dt>
          <dd>{fact.text[lang]}</dd>
        </div>
      ))}
    </dl>
    <div class="progress" data-route-progress data-js-only>
      <div class="progress-row">
        <p class="progress-text" data-progress-text aria-live="polite">
          {fill(ui.progress[lang], { done: 0, total })}
        </p>
        <button type="button" class="reset" data-progress-reset>
          <Icon name="restart" size={18} />
          {ui.reset[lang]}
        </button>
      </div>
      <div
        class="bar"
        role="progressbar"
        aria-label={ui.progressLabel[lang]}
        aria-valuemin="0"
        aria-valuemax={total}
        aria-valuenow="0"
        data-progress-bar
      >
        <span class="bar-fill" data-progress-fill></span>
      </div>
      <p class="local-notice">{ui.localNotice[lang]}</p>
    </div>
  </Container>
</div>

<style>
  .route-header {
    padding-block: 40px 56px;
    background-color: var(--color-bg);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-bottom: 24px;
    color: var(--color-text);
    font-size: 15px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .back :global(svg) {
    color: var(--color-icon);
  }
  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 40px 0 0;
  }
  .fact {
    padding-top: 16px;
    border-top: 1px solid var(--color-border-strong);
  }
  dt {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  dt :global(svg) {
    flex: none;
    color: var(--color-icon);
  }
  dd {
    margin: 10px 0 0;
    color: var(--color-text);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
  }
  .progress {
    margin-top: 40px;
  }
  .progress-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .progress-text {
    margin: 0;
    color: var(--color-text);
    font-size: 15px;
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .reset {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding-inline: 20px;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--duration-base) ease;
  }
  .reset:hover {
    border-color: var(--color-vibrant);
  }
  .bar {
    height: 6px;
    margin-top: 16px;
    background-color: var(--color-border-strong);
  }
  .bar-fill {
    display: block;
    width: 0;
    height: 100%;
    background-image: linear-gradient(90deg, var(--color-gold), var(--color-vibrant));
    transition: width var(--duration-medium) var(--ease-out-soft);
  }
  .local-notice {
    margin: 12px 0 0;
    color: var(--color-text-soft);
    font-size: 14px;
    line-height: 1.5;
  }
  @media (min-width: 48rem) {
    .route-header {
      padding-block: 48px 72px;
    }
  }
  @media (min-width: 64rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
    }
  }
</style>
