---
/*
 * Bootcamps realizados (E100-I01, ADR-074): patrón «zigzag» (DESIGN.md 11.2), una franja (7.8)
 * por bootcamp (BootcampStripe), en el orden de main. Fondos `bg` / `band` alternos y espejo en
 * las pares, como Docente (ADR-070). Sin JavaScript.
 * E200-I11 (ADR-119): el encabezado y la franja de Java (pf1162) comparten una sola capa del campo
 * de puntos del hero (texture-dots y texture-halo), sin corte, como el encabezado y la primera
 * franja de Docente (ADR-117); las otras franjas `bg` (pf1164-1 y pf1479) usan `texture="dots"`
 * de ThemeStripe. Las franjas `band` conservan la retícula (sus curvas llegan en la parte B). Las
 * portadas quedan por encima de la capa.
 */
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import BootcampStripe from './BootcampStripe.astro';
import { parseEmphasis } from '../home/hero-text';
import { langFromLocale } from '../../i18n/lang';
import { getTalentoDigitalPage } from './talento-digital-data';

const lang = langFromLocale(Astro.currentLocale);
const { bootcamps } = await getTalentoDigitalPage();
const [first, ...rest] = bootcamps.items;
if (!first) throw new Error('Bootcamps realizados necesita al menos un bootcamp');
// Fondo de cada franja después de la primera: `bg` con puntos; `band` con retícula por ahora.
const textureOf = (index: number) => (index % 2 === 1 ? 'grid' : 'dots');
---

<section class="bootcamps" aria-labelledby="bootcamps-title" data-bootcamps>
  <div class="dots-zone">
    <div class="texture-dots layer" aria-hidden="true"></div>
    <div class="texture-halo layer" aria-hidden="true"></div>
    <div class="intro">
      <Container>
        <SectionHeader
          kicker={bootcamps.kicker[lang]}
          title={bootcamps.title[lang]}
          id="bootcamps-title"
        />
        <p class="intro-lead">
          {parseEmphasis(bootcamps.lead[lang]).map((part) =>
            part.strong ? <strong>{part.text}</strong> : part.text,
          )}
        </p>
      </Container>
    </div>
    <BootcampStripe item={first} index={0} texture="grid" />
  </div>
  {rest.map((item, i) => (
    <BootcampStripe item={item} index={i + 1} texture={textureOf(i + 1)} />
  ))}
</section>

<style>
  .intro {
    padding-top: 72px;
  }
  .intro-lead {
    max-width: 60ch;
    margin: 20px 0 0;
    color: var(--color-text-soft);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.7;
  }
  .intro-lead strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .bootcamps :global(section[id]) {
    scroll-margin-top: 96px;
  }
  /* Una sola capa de puntos detrás del encabezado y de la franja de Java (4.5). */
  .dots-zone {
    position: relative;
    isolation: isolate;
    background-color: var(--color-bg);
  }
  .layer {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  /* La franja pinta su propio fondo `bg`, que taparía la capa: aquí lo pone el envoltorio. */
  .dots-zone > :global(.tone-bg) {
    background-color: transparent;
  }
  @media (min-width: 48rem) {
    .intro {
      padding-top: 96px;
    }
  }
</style>
