---
/*
 * Logros (E100-I02, ADR-076), sección S3 de main. Encabezado alineado a la izquierda («Alianzas
 * Estratégicas», h2 «Logros») con bajada con énfasis sobre `bg`; las 3 alianzas en el patrón
 * «lista a dos columnas con regla superior» (DESIGN.md 11.2, como Desarrollador) y, al cierre,
 * una banda (7.8) con 3 cifras en `dl` leídas de stats.json por id (ADR-053), separadas por la
 * barra degradada de la banda de cifras. Fondos: `bg` y `band`, alternos con la última franja
 * (`band`). Sin JavaScript.
 * E200-I11 (ADR-119): la parte lisa lleva el campo de puntos y el halo del hero (texture-dots y
 * texture-halo, 4.5) en capas decorativas detrás del contenido. Las 3 cifras van centradas, con
 * el rótulo arriba y la cifra debajo, en filas comunes (subgrid) como la banda de Inicio
 * (ADR-113): las cifras quedan en una misma línea aunque un rótulo ocupe más renglones. Estas
 * cifras no tienen línea de contexto, así que las filas comunes son dos. La banda lleva curvas de
 * nivel en vez de la retícula: espolones (spurs) en las esquinas superior izquierda e inferior
 * derecha, desvanecidos antes de las cifras (ADR-119).
 */
import Band from '../ui/Band.astro';
import Container from '../ui/Container.astro';
import ContourLines from '../ui/ContourLines.astro';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { formatNumber, parseEmphasis } from '../home/hero-text';
import { langFromLocale } from '../../i18n/lang';
import { getStat, getTalentoDigitalPage } from './talento-digital-data';

const lang = langFromLocale(Astro.currentLocale);
const { achievements } = await getTalentoDigitalPage();
const stats = await Promise.all(
  achievements.stats.map(async (item) => {
    const { value, plus } = await getStat(item.source);
    return { label: item.label[lang], value: formatNumber(value, lang), plus };
  }),
);
---

<section class="achievements" aria-labelledby="achievements-title" data-achievements>
  <div class="intro">
    <div class="texture-dots layer" aria-hidden="true"></div>
    <div class="texture-halo layer" aria-hidden="true"></div>
    <Container>
      <SectionHeader
        kicker={achievements.kicker[lang]}
        title={achievements.title[lang]}
        id="achievements-title"
      />
      <p class="lead">
        {parseEmphasis(achievements.lead[lang]).map((part) =>
          part.strong ? <strong>{part.text}</strong> : part.text,
        )}
      </p>
      <ul class="list" data-alliances>
        {achievements.items.map((item) => (
          <li class="item">
            <span class="icon">
              <Icon name={item.icon} size={32} />
            </span>
            <p class="item-text">{item.text[lang]}</p>
          </li>
        ))}
      </ul>
    </Container>
  </div>
  <Band class="figures" texture="contour">
    <ContourLines
      slot="decor"
      pieces={[
        { corner: 'top-left', shape: 'spurs' },
        { corner: 'bottom-right', shape: 'spurs' },
      ]}
      mask="none"
    />
    <dl class="stats" aria-label={achievements.statsLabel[lang]} data-achievement-stats>
      {stats.map((stat) => (
        <div class="stat">
          <dt>{stat.label}</dt>
          <dd>
            {stat.plus && <span class="sign">+</span>}
            {stat.value}
          </dd>
        </div>
      ))}
    </dl>
  </Band>
</section>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    padding-block: 80px;
    background-color: var(--color-bg);
  }
  .layer {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .lead {
    max-width: 60ch;
    margin: 20px 0 0;
    color: var(--color-text-soft);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.7;
  }
  .lead strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  /* Regla superior de 1 px con tramo degradado de 48 px, como Desarrollador (11.2). */
  .item {
    position: relative;
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding-top: 28px;
    border-top: 1px solid var(--color-border-strong);
  }
  .item::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-gold), var(--color-vibrant));
  }
  .icon {
    flex: none;
    color: var(--color-icon);
  }
  .item-text {
    margin: 4px 0 0;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 64rem;
    margin: 0 auto;
  }
  /* Rótulo y cifra en dos filas comunes (subgrid), centrados en cada celda. Bajo 480 px el
     relleno baja a 8 px, y a 0 bajo 360 px, para que «+2.000» quepa en su columna (AT-158). */
  .stat {
    position: relative;
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    min-width: 0;
    padding-inline: 8px;
    text-align: center;
  }
  .stat + .stat::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--color-gold), var(--color-vibrant));
  }
  dt {
    align-self: end;
    font-weight: 400;
    font-family: var(--font-mono);
    color: var(--color-text-soft);
    font-size: 12px;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  dd {
    margin: 12px 0 0;
    color: var(--color-heading);
    font-family: var(--font-display);
    letter-spacing: -0.01em;
    font-size: clamp(1.625rem, 3vw, 2.6rem);
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1;
  }
  .sign {
    color: var(--metric-sign);
  }
  /* Bajo 360 px, sin relleno lateral: centrada, «+2.000» necesita todo el ancho de su columna. */
  @media (max-width: 22.49rem) {
    .stat {
      padding-inline: 0;
    }
  }
  @media (min-width: 30rem) {
    .stat {
      padding-inline: 16px;
    }
  }
  @media (min-width: 48rem) {
    .intro {
      padding-block: 96px;
    }
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 56px;
    }
    .stat {
      padding-inline: 24px;
    }
  }
  /* Curvas de la banda de cifras (E200-I11, ADR-119): spurs se dibuja para top-left y se gira en
     bottom-right. Se desvanece desde la esquina antes de la cifra más cercana (`dl` centrado de
     64 rem); bajo 1.024 px las cifras ocupan el ancho y la pieza queda en el relleno. Vive aquí y
     no en ContourLines por el límite para insertar la hoja en el HTML (AT-165). */
  .achievements :global(.shape-spurs) {
    mask-image: radial-gradient(
      ellipse clamp(100px, calc(50vw - 440px), 520px) 220px at 0 0,
      black 30%,
      transparent 100%
    );
  }
  .achievements :global(.shape-spurs.top-left) {
    transform: none;
  }
  .achievements :global(.shape-spurs.bottom-right) {
    transform: scale(-1, -1);
  }
  @media (max-width: 63.999rem) {
    .achievements :global(.shape-spurs) {
      mask-image: radial-gradient(ellipse 25vw 50px at 0 0, black 30%, transparent 100%);
    }
  }
</style>
