---
/*
 * Relatoría (E90-I02, ADR-073): grilla simétrica de 6 tarjetas compactas (DESIGN.md 7.6 y
 * 11.2) en 2 columnas desde 1.024 px y una bajo esa medida, de la experiencia más reciente a la
 * más antigua. Cada tarjeta: caja de ícono de 44 px, institución (h3), cargo en chip (7.7),
 * periodo · modalidad con ícono `event` y texto con énfasis (ADR-068). Se renderiza al
 * construir: sin JavaScript ni animaciones (reemplaza a relatoria.js y AOS de main).
 * Encabezado alineado a la izquierda, fondo `bg-alt`.
 */
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Tag from '../ui/Tag.astro';
import { parseEmphasis } from '../home/hero-text';
import { langFromLocale } from '../../i18n/lang';
import { getInstructorPage } from './instructor-data';

const lang = langFromLocale(Astro.currentLocale);
const { teaching } = await getInstructorPage();
---

<section class="teaching" aria-labelledby="teaching-title">
  <Container>
    <SectionHeader
      kicker={teaching.kicker[lang]}
      title={teaching.title[lang]}
      id="teaching-title"
    />
    <ul class="grid" data-teaching>
      {teaching.items.map((item) => (
        <Card as="li" size="compact" class="experience">
          <div id={item.id} class="body" data-experience={item.id}>
            <div class="head">
              <span class="icon-box">
                <Icon name={item.icon} size={24} />
              </span>
              <h3 class="institution">{item.institution}</h3>
              <Tag class="role">{item.role[lang]}</Tag>
            </div>
            <p class="meta">
              <Icon name="event" size={16} />
              <span>
                {item.period[lang]} · {item.modality[lang]}
              </span>
            </p>
            <p class="text">
              {parseEmphasis(item.text[lang]).map((part) =>
                part.strong ? <strong>{part.text}</strong> : part.text,
              )}
            </p>
          </div>
        </Card>
      ))}
    </ul>
  </Container>
</section>

<style>
  .teaching {
    padding-block: 80px;
    background-color: var(--color-bg-alt);
  }
  .grid {
    display: grid;
    gap: 24px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  .body {
    scroll-margin-top: 84px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .icon-box {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    box-shadow: 0 0 0 1px var(--color-border-strong);
    color: var(--color-icon);
  }
  .institution {
    flex: 1 1 auto;
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.3;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 16px 0 0;
    color: var(--color-text-soft);
    font-size: 13px;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .meta :global(svg) {
    flex: none;
    color: var(--color-icon);
  }
  .text {
    margin: 12px 0 0;
    color: var(--color-text-muted);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.7;
  }
  .text strong {
    color: var(--color-text);
    font-weight: 600;
  }
  @media (min-width: 48rem) {
    .teaching {
      padding-block: 96px;
    }
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
  }
</style>
