---
/*
 * Instructor titular (E90-I01, ADR-072): banda de ancho completo (7.8) con encabezado de banda,
 * el texto del cargo, 2 cifras en un `dl` y la descarga del certificado REUF. «+3» y «+150»
 * salen de stats.json (ids reuf-years y reuf-modules, ADR-053). El PDF conserva la URL de main
 * (AT-043) y en en-US se avisa que está en español (ADR-017). Sin animación ni JavaScript.
 */
import Band from '../ui/Band.astro';
import Button from '../ui/Button.astro';
import { formatNumber, parseEmphasis } from '../home/hero-text';
import { langFromLocale } from '../../i18n/lang';
import { getInstructorPage, getStat, REUF_CERTIFICATE_URL } from './instructor-data';

const lang = langFromLocale(Astro.currentLocale);
const { titular } = await getInstructorPage();
const stats = await Promise.all(
  titular.stats.map(async (item) => {
    const { value, plus } = await getStat(item.source);
    return { id: item.source, label: item.label[lang], value: formatNumber(value, lang), plus };
  }),
);
const { certificate } = titular;
const emphasis = (text: string) => parseEmphasis(text);
---

<Band id="titular" kicker={titular.kicker[lang]} title={titular.title[lang]}>
  <div class="layout">
    <p class="text">
      {emphasis(titular.text[lang]).map((part) =>
        part.strong ? <strong>{part.text}</strong> : part.text,
      )}
    </p>
    <dl class="stats" data-titular-stats>
      {stats.map((stat) => (
        <div class="stat" data-stat={stat.id}>
          <dt>{stat.label}</dt>
          <dd>
            {stat.plus && <span class="sign">+</span>}
            {stat.value}
          </dd>
        </div>
      ))}
    </dl>
    <div class="certificate" data-certificate>
      <Button
        variant="gold"
        icon="download"
        href={REUF_CERTIFICATE_URL}
        download="Certificado_REUF_Aprobados_Felipe_Cuevas_2026.pdf"
        label={certificate.accessibleName[lang]}
      >
        {certificate.label[lang]}
      </Button>
      <p class="certificate-text">
        {emphasis(certificate.text[lang]).map((part) =>
          part.strong ? <strong>{part.text}</strong> : part.text,
        )}
        {lang === 'en' && <span data-language-note> {certificate.languageNote.en}</span>}
      </p>
    </div>
  </div>
</Band>

<style>
  .layout {
    display: grid;
    gap: 40px;
    max-width: 64rem;
    margin-inline: auto;
  }
  .text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.7;
  }
  .text strong,
  .certificate-text strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }
  .stat {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    min-width: 0;
    padding-inline: 16px;
  }
  .stat:first-child {
    padding-inline-start: 0;
  }
  .stat + .stat::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--color-gold), var(--color-vibrant));
  }
  dt {
    color: var(--color-text-soft);
    font-size: 12px;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  dd {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1;
  }
  .sign {
    color: var(--metric-sign);
  }
  .certificate-text {
    margin: 12px 0 0;
    color: var(--color-text-soft);
    font-size: 14px;
    line-height: 1.5;
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: 5fr 4fr 3fr;
      align-items: center;
      gap: 48px;
    }
    .stat {
      padding-inline: 24px;
    }
  }
</style>
