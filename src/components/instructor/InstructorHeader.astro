---
/*
 * Cabecera de Instructor (E90-I01, ADR-072): el único <h1>, con rótulo y bajada con énfasis
 * (ADR-068). Alineada a la izquierda (DESIGN.md 7.5), fondo `bg`, sin JavaScript.
 */
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { parseEmphasis } from '../home/hero-text';
import { langFromLocale } from '../../i18n/lang';
import { getInstructorPage } from './instructor-data';

const lang = langFromLocale(Astro.currentLocale);
const { header } = await getInstructorPage();
---

<div class="instructor-header">
  <Container>
    <SectionHeader
      level={1}
      kicker={header.kicker[lang]}
      title={header.title[lang]}
      id="instructor-title"
    />
    <p class="lead" data-lead>
      {parseEmphasis(header.lead[lang]).map((part) =>
        part.strong ? <strong>{part.text}</strong> : part.text,
      )}
    </p>
  </Container>
</div>

<style>
  .instructor-header {
    padding-block: 64px 56px;
    background-color: var(--color-bg);
  }
  .lead {
    max-width: 52ch;
    margin: 20px 0 0;
    color: var(--color-text-soft);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.7;
  }
  .lead strong {
    color: var(--color-text);
    font-weight: 600;
  }
  @media (min-width: 48rem) {
    .instructor-header {
      padding-block: 80px 64px;
    }
  }
</style>
