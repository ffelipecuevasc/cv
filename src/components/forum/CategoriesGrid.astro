---
/*
 * «Dónde publicar cada cosa» (E120-I01, ADR-078): grilla simétrica de tarjetas en su variante
 * 2 × 2 sin foto (DESIGN.md 11.2, como Asignaturas de Docente): 4 tarjetas base (7.6) con h3 y
 * texto, 2 columnas desde 1.024 px y una bajo esa medida. Encabezado centrado, fondo `bg-alt`.
 */
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { langFromLocale } from '../../i18n/lang';
import { getForumPage } from './forum-data';

const lang = langFromLocale(Astro.currentLocale);
const { categories } = await getForumPage();
---

<section class="categories" aria-labelledby="categories-title">
  <Container>
    <SectionHeader
      variant="center"
      kicker={categories.kicker[lang]}
      title={categories.title[lang]}
      id="categories-title"
    />
    <ul class="grid" data-categories>
      {categories.items.map((item) => (
        <Card as="li">
          <h3 class="category-title">{item.title[lang]}</h3>
          <p class="text">{item.text[lang]}</p>
        </Card>
      ))}
    </ul>
  </Container>
</section>

<style>
  .categories {
    padding-block: 80px;
    background-color: var(--color-bg-alt);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  .category-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .text {
    margin: 12px 0 0;
    color: var(--color-text-muted);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.65;
  }
  @media (min-width: 48rem) {
    .categories {
      padding-block: 96px;
    }
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
  }
</style>
