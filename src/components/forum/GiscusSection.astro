---
/*
 * Sección de conversación con Giscus (E120-I01 y E130-I01; ADR-022, ADR-078 y ADR-079). La usan el
 * Foro (hilo `foro-general`) y la ruta de Recursos (hilo `ruta-desarrollo-web-ia`): encabezado
 * alineado a la izquierda sobre `bg`, aviso de transparencia, panel de Giscus y enlace a GitHub.
 * Los textos comunes (aviso, marcador y alternativa) salen del contenido del Foro: un solo origen.
 * - Panel `surface` con alto mínimo reservado (520 px) antes de la carga: el contenido de abajo
 *   no se desplaza (sin CLS). El marcador es estático: sin spinner giratorio (DESIGN.md 8).
 * - Carga diferida: src/scripts/giscus.ts inyecta Giscus cuando el panel queda a 400 px de la
 *   pantalla. El término es el mismo en ambos idiomas; `data-lang` según la página (AT-027) y
 *   tema en vivo con la clase `.dark` de <html> (ADR-023).
 * - Sin JavaScript el panel no se muestra y el <noscript> enlaza a las discusiones.
 * Hay un solo panel por página.
 */
import Container from '../ui/Container.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { langFromLocale } from '../../i18n/lang';
import { getRoute } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import { GISCUS, GISCUS_LANG, getForumPage } from './forum-data';
import type { GiscusTerm } from '../../data/giscus';

interface Props {
  term: GiscusTerm;
  kicker: string;
  title: string;
  /** id del titular; nombra la sección. */
  id: string;
  /*
   * Enlace a la política de privacidad del aviso (ADR-035). Por defecto es la ruta `privacy` del
   * mapa de rutas con el texto del pie (E155-I01); se puede reemplazar o pasar `null` para quitarlo.
   */
  privacy?: { href: string; label: string } | null;
}
const { term, kicker, title, id } = Astro.props;
const lang = langFromLocale(Astro.currentLocale);
const privacy =
  Astro.props.privacy === undefined
    ? { href: getRoute('privacy', lang), label: useTranslations(lang).footer.privacy }
    : Astro.props.privacy;
const { conversation } = await getForumPage();
---

<section class="conversation" aria-labelledby={id}>
  <Container>
    <SectionHeader {kicker} {title} {id} />
    <p class="notice" data-forum-notice>
      <Icon name="info" size={20} class="notice-icon" />
      <span>
        {conversation.notice[lang]}
        {privacy && (
          <>
            {' '}
            <a href={privacy.href}>{privacy.label}</a>
          </>
        )}
      </span>
    </p>
    <div
      class="panel"
      id="forum-thread"
      data-forum-thread
      data-repo={GISCUS.repo}
      data-repo-id={GISCUS.repoId}
      data-category={GISCUS.category}
      data-category-id={GISCUS.categoryId}
      data-term={term}
      data-lang={GISCUS_LANG[lang]}
      data-theme-light={GISCUS.themes.light}
      data-theme-dark={GISCUS.themes.dark}
      data-root-margin={GISCUS.rootMargin}
      data-script={GISCUS.script}
      data-origin={GISCUS.origin}
    >
      <div class="placeholder" data-forum-placeholder>
        <Icon name="forum" size={32} class="placeholder-icon" />
        <p role="status">{conversation.loading[lang]}</p>
      </div>
    </div>
    <noscript>
      <style is:inline>
        [data-forum-thread] {
          display: none !important;
        }
      </style>
      <div class="panel panel-static" data-forum-noscript>
        <p>{conversation.noscript[lang]}</p>
        <p class="noscript-cta">
          <ExternalLink href={GISCUS.discussionsUrl} {lang}>
            {conversation.noscriptCta[lang]}
          </ExternalLink>
        </p>
      </div>
    </noscript>
    <p class="github-link">
      <ExternalLink href={GISCUS.discussionsUrl} {lang}>
        {conversation.githubLink[lang]}
      </ExternalLink>
    </p>
  </Container>
</section>

<script>
  import { initGiscus } from '../../scripts/giscus';

  initGiscus();
</script>

<style>
  .conversation {
    padding-block: 80px;
    background-color: var(--color-bg);
  }
  .notice {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 62ch;
    margin: 32px 0 0;
    padding: 16px 20px;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-alt);
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.6;
  }
  .notice :global(.notice-icon) {
    flex: none;
    margin-top: 1px;
    color: var(--color-icon);
  }
  /* Enlace de texto: `text`, 600 y subrayado (DESIGN.md 11.10 y 4.3). */
  .notice a {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .notice a:hover {
    color: var(--color-heading);
  }
  .panel {
    min-height: 520px;
    margin-top: 24px;
    padding: 16px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .panel-static {
    min-height: 0;
    padding: 24px;
    color: var(--color-text-muted);
  }
  .noscript-cta {
    margin-top: 16px;
  }
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 486px;
    color: var(--color-text-soft);
    font-size: 15px;
    text-align: center;
  }
  .placeholder :global(.placeholder-icon) {
    color: var(--color-icon);
  }
  .github-link {
    margin: 24px 0 0;
    font-size: 15px;
    font-weight: 600;
    text-align: center;
  }
  @media (min-width: 48rem) {
    .conversation {
      padding-block: 96px;
    }
    .panel {
      padding: 24px;
    }
    .placeholder {
      min-height: 470px;
    }
  }
</style>
