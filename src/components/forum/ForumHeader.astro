---
/*
 * Cabecera del Foro (E120-I01, ADR-078): el único <h1>, con rótulo y bajada, alineada a la
 * izquierda sobre `bg`, como Docente e Instructor. Sin JavaScript.
 * E200-I12 (ADR-120): campo de puntos y halo del hero (texture-dots y texture-halo, DESIGN.md 4.5)
 * en capas decorativas detrás del contenido.
 */
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { langFromLocale } from '../../i18n/lang';
import { getForumPage } from './forum-data';

const lang = langFromLocale(Astro.currentLocale);
const { header } = await getForumPage();
---

<div class="forum-header">
  <div class="texture-dots layer" aria-hidden="true"></div>
  <div class="texture-halo layer" aria-hidden="true"></div>
  <Container>
    <SectionHeader
      level={1}
      kicker={header.kicker[lang]}
      title={header.title[lang]}
      lead={header.lead[lang]}
      id="forum-title"
    />
  </Container>
</div>

<style>
  .forum-header {
    position: relative;
    isolation: isolate;
    padding-block: 64px 56px;
    background-color: var(--color-bg);
  }
  /* Campo de puntos y halo del hero (4.5, ADR-120): capas decorativas detrás del contenido. */
  .layer {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  @media (min-width: 48rem) {
    .forum-header {
      padding-block: 80px 72px;
    }
  }
</style>
