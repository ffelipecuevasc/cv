---
/*
 * Bloque «Instructor REUF» y cierre de Educación (E50-I02, AT-076, ADR-061), migrados de
 * `main:educacion.html`. La cifra de módulos se toma de src/content/home/stats.json (la misma
 * que muestra la portada), para que no se desfase (ADR-053). Panel de 3 cifras (E200-I06, ADR-114):
 * módulos aprobados, años de experiencia y bootcamps, con el valor y el «+» de stats.json por id y
 * el «+» antepuesto como en la banda de Inicio. Desde 1.024 px va a la derecha del texto, tras una
 * barra gold → vibrant (ADR-058); entre 768 y 1.023 px, en una fila de 3 bajo el texto; bajo
 * 768 px, apiladas. El cierre repite el CV del pie
 * (ADR-050, ADR-057) y enlaza a Contacto. Sin JavaScript. Dentro de <main>.
 */
import { getEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { parseEmphasis, formatNumber } from '../home/hero-text';
import { cv } from '../layout/footer-links';
import { getRoute } from '../../i18n/routes';
import { langFromLocale } from '../../i18n/lang';
import { getStat } from '../../data/stats';

const lang = langFromLocale(Astro.currentLocale);
const page = (await getEntry('educationPage', 'page'))?.data;
if (!page) throw new Error('Faltan los textos de Educación');

const modules = await getStat('reuf-modules');
const figures = await Promise.all(
  page.reuf.figures.map(async ({ source, label }) => {
    const { value, plus } = await getStat(source);
    return { label: label[lang], value: formatNumber(value, lang), plus };
  }),
);
const paragraph = parseEmphasis(
  page.reuf.paragraph[lang].replace('{modules}', formatNumber(modules.value, lang)),
);
const { closing } = page;
---

<section class="reuf" aria-labelledby="education-reuf-title">
  <Container>
    <Card class="reuf-card">
      <div class="reuf-grid">
        <Icon name="medal" size={48} class="reuf-icon" />
        <div>
          <h2 id="education-reuf-title" class="reuf-title">
            {page.reuf.title[lang]}
          </h2>
          <p class="reuf-text">
            {paragraph.map((part) => (part.strong ? <strong>{part.text}</strong> : part.text))}
          </p>
        </div>
        <dl class="reuf-figures" data-reuf-figures>
          {figures.map((item) => (
            <div class="reuf-figure">
              <dt>{item.label}</dt>
              <dd>
                {item.plus && <span class="sign">+</span>}
                {item.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </Card>

    <div class="closing">
      <p class="closing-kicker">{closing.kicker[lang]}</p>
      <div class="closing-actions">
        <Button
          href={cv.href}
          download={cv.file}
          icon="download"
          label={closing.cvLabel[lang]}
          title={closing.cvLabel[lang]}
        >
          {closing.cv[lang]}
        </Button>
        <Button variant="secondary" href={getRoute('contact', lang)}>
          {closing.contact[lang]}
        </Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .reuf {
    padding-block: 80px;
    background-color: var(--color-bg-alt);
  }
  @media (min-width: 48rem) {
    .reuf {
      padding-block: 96px;
    }
  }
  .reuf-grid {
    display: grid;
    gap: 24px;
  }
  .reuf-grid :global(.reuf-icon) {
    color: var(--color-icon);
  }
  @media (min-width: 48rem) {
    .reuf-grid {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 32px;
    }
  }
  .reuf-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .reuf-text {
    max-width: 62ch;
    margin-top: 16px;
    color: var(--color-text-muted);
    font-weight: 400;
    line-height: 1.75;
  }
  .reuf-text strong {
    color: var(--color-text);
    font-weight: 600;
  }
  /* Panel de cifras (ADR-114). Barra de 2 px con el degradado de la regla dorada (ADR-058) y
     divisores finos `border` entre cifras. Bajo 1.024 px la barra va arriba, en horizontal. */
  .reuf-figures {
    position: relative;
    display: grid;
    margin: 0;
    padding-top: 26px;
  }
  .reuf-figures::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-gold), var(--color-vibrant));
  }
  .reuf-figure {
    min-width: 0;
    padding-block: 18px;
  }
  .reuf-figure:first-child {
    padding-top: 0;
  }
  .reuf-figure:last-child {
    padding-bottom: 0;
  }
  .reuf-figure + .reuf-figure {
    border-top: 1px solid var(--color-border);
  }
  dt {
    color: var(--color-text-soft);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  dd {
    margin: 8px 0 0;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 2.5rem;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1;
  }
  .sign {
    color: var(--metric-sign);
  }
  /* 768 a 1.023 px: fila de 3 bajo el texto, con divisores verticales. */
  @media (min-width: 48rem) and (max-width: 63.999rem) {
    /* Rótulo y cifra en filas comunes (subgrid, como en Inicio): las cifras quedan en una misma
       línea aunque un rótulo ocupe 2 líneas en inglés. */
    .reuf-figures {
      grid-template-rows: auto auto;
    }
    .reuf-figure {
      display: grid;
      grid-row: span 2;
      grid-template-rows: subgrid;
    }
    .reuf-figure dt {
      align-self: end;
    }
  }
  @media (min-width: 48rem) {
    .reuf-figures {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .reuf-figure,
    .reuf-figure:first-child,
    .reuf-figure:last-child {
      padding-block: 0;
      padding-inline: 24px;
    }
    .reuf-figure:first-child {
      padding-inline-start: 0;
    }
    .reuf-figure:last-child {
      padding-inline-end: 0;
    }
    .reuf-figure + .reuf-figure {
      border-top: 0;
      border-inline-start: 1px solid var(--color-border);
    }
  }
  /* Desde 1.024 px: panel a la derecha, cifras apiladas y barra vertical a su izquierda. */
  @media (min-width: 64rem) {
    .reuf-grid {
      grid-template-columns: auto minmax(0, 1fr) minmax(15rem, 18rem);
    }
    .reuf-figures {
      align-self: center;
      grid-column: auto;
      grid-template-columns: none;
      padding-top: 0;
      padding-inline-start: 32px;
    }
    .reuf-figures::before {
      inset-block: 0;
      inset-inline: 0 auto;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, var(--color-gold), var(--color-vibrant));
    }
    .reuf-figure,
    .reuf-figure:first-child,
    .reuf-figure:last-child {
      padding-inline: 0;
      padding-block: 18px;
    }
    .reuf-figure:first-child {
      padding-top: 0;
    }
    .reuf-figure:last-child {
      padding-bottom: 0;
    }
    .reuf-figure + .reuf-figure {
      border-inline-start: 0;
      border-top: 1px solid var(--color-border);
    }
  }
  .closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    margin-top: 64px;
    text-align: center;
  }
  .closing-kicker {
    font-family: var(--font-mono);
    margin: 0;
    color: var(--color-text-soft);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
</style>
