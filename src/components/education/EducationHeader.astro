---
/*
 * Encabezado de Educación (E50-I01, DESIGN.md 7.5 y 11.4): el único <h1> de la página, con
 * rótulo y bajada, alineado a la izquierda. Fondo `bg`. Dentro de <main>.
 */
import { getEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { langFromLocale } from '../../i18n/lang';

const lang = langFromLocale(Astro.currentLocale);
const page = (await getEntry('educationPage', 'page'))?.data;
if (!page) throw new Error('Falta src/content/education/page.json');
const { header } = page;
---

<div class="education-header">
  <Container>
    <SectionHeader
      level={1}
      kicker={header.kicker[lang]}
      title={header.title[lang]}
      lead={header.lead[lang]}
      id="education-title"
    />
  </Container>
</div>

<style>
  .education-header {
    padding-block: 64px 56px;
    background-color: var(--color-bg);
  }
  @media (min-width: 48rem) {
    .education-header {
      padding-block: 80px 64px;
    }
  }
</style>
