---
/*
 * Certificaciones de Educación (E50-I02, DESIGN.md 7.8 y 11.4, ADR-036, ADR-061):
 * encabezado alineado a la izquierda y una franja temática por categoría (IA, Cloud,
 * Desarrollo y datos), en zigzag y con fondo `band` / `bg` alternado. Dentro de <main>.
 * - Datos: src/data/certifications.ts, fuente única (ADR-053). No hay segunda lista.
 * - Insignias de src/assets/badges/ con carga diferida, ancho y alto declarados (AT-013).
 *   Si una credencial aún no tiene insignia, se usa la del emisor como marcador (AT-077).
 * - Detalle: visible en la franja sin JavaScript; con JavaScript se abre en un <dialog>
 *   nativo (src/scripts/certifications.ts).
 * - Sin vencimientos: no se muestran ni se filtran (ADR-061).
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ThemeStripe from '../ui/ThemeStripe.astro';
import IconButton from '../ui/IconButton.astro';
import Icon from '../ui/Icon.astro';
import {
  certifications,
  certificationCategories,
  type CertificationIssuer,
} from '../../data/certifications';
import { issuerOrganizations } from '../seo/structured-data';
import { langCodes, langFromLocale } from '../../i18n/lang';

const lang = langFromLocale(Astro.currentLocale);
const page = (await getEntry('educationPage', 'page'))?.data;
if (!page) throw new Error('Falta src/content/education/page.json');
const text = page.certifications;

const badges = import.meta.glob<{ default: ImageMetadata }>('../../assets/badges/*.png', {
  eager: true,
});
const issuerBadges = import.meta.glob<{ default: ImageMetadata }>('../../assets/insignias/*.png', {
  eager: true,
});
// Insignia del emisor, como marcador mientras falte la de la credencial (AT-077).
const issuerFile: Record<CertificationIssuer, string> = {
  oracle: 'insignia_oracle',
  aws: 'insignia_aws',
  'python-institute': 'insignia_python',
  anthropic: 'insignia_anthropic',
};
const badgeFor = (badge: string | null, issuer: CertificationIssuer): ImageMetadata => {
  const source = badge
    ? badges[`../../assets/badges/${badge}.png`]
    : issuerBadges[`../../assets/insignias/${issuerFile[issuer]}.png`];
  if (!source) throw new Error(`Falta la insignia ${badge ?? issuerFile[issuer]}`);
  return source.default;
};

const monthYear = new Intl.DateTimeFormat(langCodes[lang], {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

const stripes = certificationCategories.map((category) => ({
  category,
  title: text.categories[category][lang],
  items: certifications
    .filter((item) => item.category === category)
    .map((item) => ({
      id: item.id,
      name: item.name,
      issuer: issuerOrganizations[item.issuer].name,
      date: item.issuedAt.slice(0, 7),
      dateLabel: monthYear.format(new Date(`${item.issuedAt.slice(0, 7)}-01T00:00:00Z`)),
      skills: item.skills[lang],
      description: item.description[lang],
      url: item.url,
      image: badgeFor(item.badge, item.issuer),
    })),
}));
---

<section class="certifications" aria-labelledby="education-certs-title" data-certs>
  <div class="certs-intro">
    <Container>
      <SectionHeader
        kicker={text.kicker[lang]}
        title={text.title[lang]}
        lead={text.lead[lang]}
        id="education-certs-title"
      />
    </Container>
  </div>

  {stripes.map((stripe, index) => (
    <ThemeStripe
      id={`certs-${stripe.category}`}
      kicker={text.stripeKicker[lang]}
      title={stripe.title}
      level={3}
      reverse={index % 2 === 1}
      tone={index % 2 === 0 ? 'band' : 'bg'}
    >
      <ul class="cert-list">
        {stripe.items.map((item) => (
          <li class="cert" data-cert>
            <Image
              src={item.image}
              width={72}
              densities={[1, 2]}
              alt=""
              loading="lazy"
              decoding="async"
              class="cert-badge"
            />
            <div class="cert-body">
              <h4 class="cert-name" data-cert-name>
                {item.name}
              </h4>
              <p class="cert-meta">
                {item.issuer} · {text.issued[lang]}{' '}
                <time datetime={item.date}>{item.dateLabel}</time>
              </p>
              <button
                type="button"
                class="cert-open"
                data-cert-open
                hidden
                aria-label={`${text.details[lang]}: ${item.name}`}
              >
                {text.details[lang]}
              </button>
              <div class="cert-detail" data-cert-detail>
                <p class="detail-label">{text.skills[lang]}</p>
                <p class="detail-skills">{item.skills}</p>
                <p class="detail-description">{item.description}</p>
                <a class="detail-verify" href={item.url} target="_blank" rel="noopener noreferrer">
                  <Icon name="external-link" size={16} />
                  <span>{text.verify[lang]}</span>
                  <span class="sr-only">
                    {item.name} {text.newTab[lang]}
                  </span>
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </ThemeStripe>
  ))}

  <dialog class="cert-dialog" data-cert-dialog aria-labelledby="cert-dialog-title">
    <div class="dialog-head">
      <h2 id="cert-dialog-title" class="dialog-title" data-cert-dialog-title></h2>
      <IconButton icon="close" label={text.close[lang]} data-cert-close="" />
    </div>
    <div data-cert-dialog-body></div>
  </dialog>
</section>

<script>
  import { initCertifications } from '../../scripts/certifications';
  initCertifications();
</script>

<style>
  .certs-intro {
    padding-block: 80px 24px;
    background-color: var(--color-bg);
  }
  @media (min-width: 48rem) {
    .certs-intro {
      padding-block: 96px 32px;
    }
  }

  .cert-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 24px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cert {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: start;
    gap: 16px;
  }
  .cert-badge {
    width: 72px;
    height: auto;
  }
  p {
    margin: 0;
  }
  .cert-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .cert-meta {
    margin-top: 6px;
    color: var(--color-text-soft);
    font-size: 13px;
    line-height: 1.4;
  }
  /* Botón de texto con zona táctil de 44 px (DESIGN.md 8). */
  .cert-open {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    color: var(--color-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 6px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .cert-open:hover {
    text-decoration-color: var(--color-vibrant);
  }
  .cert-open[hidden] {
    display: none;
  }

  .cert-detail {
    margin-top: 12px;
  }
  /* Con JavaScript el detalle vive en el diálogo, no en la franja. */
  [data-js] [data-cert] .cert-detail {
    display: none;
  }
  .detail-label {
    color: var(--color-kicker);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .detail-skills {
    margin-top: 4px;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.5;
  }
  .detail-description {
    margin-top: 12px;
    color: var(--color-text-muted);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
  }
  /* 4.3 y ADR-046: sobre `band` el enlace pequeño va en `text`, no en `accent`. */
  .detail-verify {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 8px;
    color: var(--color-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 6px;
  }
  .detail-verify:hover {
    text-decoration-color: var(--color-vibrant);
  }

  /* Diálogo: panel `surface` sin radio, línea superior gold → vibrant y sombra `float`. */
  .cert-dialog {
    width: min(100% - 32px, 560px);
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 32px;
    color: var(--color-text);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-gold);
    box-shadow: var(--shadow-float);
  }
  .cert-dialog::backdrop {
    background-color: color-mix(in srgb, var(--color-orient-950) 60%, transparent);
  }
  .dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .dialog-title {
    padding-top: 8px;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .cert-dialog .cert-detail {
    margin-top: 16px;
  }
</style>
