---
/*
 * Volver arriba (E30-I06, DESIGN.md 7.11): botón de ícono de 44 × 44 fijo abajo a la
 * derecha, con el estilo de la flecha del carrusel. Aparece tras desplazarse una pantalla.
 * Con movimiento reducido el desplazamiento es instantáneo. Es un enlace a #top: sin
 * JavaScript queda siempre visible (noscript en BaseLayout) y salta al inicio.
 */
import IconButton from '../ui/IconButton.astro';
import { langFromLocale } from '../../i18n/lang';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations(langFromLocale(Astro.currentLocale));
---

<IconButton
  icon="arrow-up"
  variant="arrow"
  href="#top"
  label={t.backToTop}
  class="back-to-top"
  data-back-to-top=""
/>

<script>
  const button = document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
  if (button) {
    // El respaldo sin JavaScript lo muestra siempre; con él, solo tras una pantalla.
    const update = () => button.classList.toggle('is-visible', window.scrollY > window.innerHeight);
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    button.addEventListener('click', (event) => {
      event.preventDefault();
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      // El botón se oculta al llegar arriba: el foco pasa al logotipo, no se pierde.
      document.querySelector<HTMLElement>('.navbar a')?.focus({ preventScroll: true });
    });
  }
</script>

<style>
  /* El botón lo pinta IconButton: se alcanza con :global. Mide 44 × 44 (7.11) y no los
     54 × 54 de la flecha del carrusel; el selector largo supera al estilo acotado. */
  :global(a.icon-button.back-to-top) {
    position: fixed;
    right: 24px;
    bottom: calc(24px + env(safe-area-inset-bottom));
    z-index: 30;
    width: 44px;
    height: 44px;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--duration-fast) ease,
      visibility 0s linear var(--duration-fast),
      color var(--duration-base) ease,
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease;
  }
  :global(a.icon-button.back-to-top.is-visible) {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(a.icon-button.back-to-top) {
      transition: none;
    }
  }
</style>
