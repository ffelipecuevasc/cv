---
/*
 * Logotipo (E30-I03, DESIGN.md 3, ADR-049).
 * - Enlace a la portada del idioma activo (P-03), con nombre accesible fijo.
 * - Ícono: «terminal» de Material Symbols Light (Apache 2.0, ADR-057) como máscara de
 *   32 × 32, color `icon`. El favicon sigue siendo `static/img/favicon.svg`.
 * - Renglón 1: "Felipe Cuevas" en Cinzel, fijo. Renglón 2: frases con máquina de
 *   escribir (decorativas), ocultas bajo 640 px.
 * - Copias invisibles de todas las frases reservan el ancho de la más ancha (CLS 0).
 * - `animated={false}` (pie, DESIGN.md 7.9): solo ícono y nombre, sin frases ni efecto.
 */
interface Props {
  animated?: boolean;
}
import { langFromLocale } from '../../i18n/lang';
import { getRoute } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import { logoPhrases } from './logo-phrases';

const { animated = true } = Astro.props;
const lang = langFromLocale(Astro.currentLocale);
const t = useTranslations(lang);
const phrases = logoPhrases[lang];
---

<a href={getRoute('home', lang)} class="logo" aria-label={t.logo.label}>
  <span class="logo-icon" aria-hidden="true"></span>
  <span class="logo-text">
    <span class="logo-name">Felipe Cuevas</span>
    {animated && (
      <span
        class="logo-phrases typewriter"
        data-typewriter={JSON.stringify(phrases)}
        aria-hidden="true"
      >
        {phrases.map((phrase) => (
          <span class="typewriter-measure">{phrase}</span>
        ))}
        <span class="typewriter-text">{phrases[0]}</span>
      </span>
    )}
  </span>
</a>

<script>
  import { initTypewriters, logoRhythm } from '../../scripts/typewriter';
  initTypewriters('.logo [data-typewriter]', logoRhythm);
</script>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    text-decoration: none;
  }

  /* 3.1: máscara del SVG pintada con `icon` (orient-600 / orient-400), 300 ms. */
  .logo-icon {
    flex: none;
    width: 32px;
    height: 32px;
    background-color: var(--color-icon);
    mask: url('../../assets/logo/terminal-icon.svg') center / contain no-repeat;
    transition: background-color 300ms;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* 3.2 renglón 1. Color `heading` (#00131D / #FFFFFF), ver AT-057. */
  .logo-name {
    font-family: var(--font-display);
    font-size: 14px;
    line-height: 1.1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-heading);
  }

  /* 3.2 renglón 2: oculto bajo 640 px. */
  .logo-phrases {
    display: none;
    font-family: var(--font-sans);
    font-size: 11.5px;
    line-height: 1.2;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }

  @media (min-width: 640px) {
    .logo-name {
      font-size: 18px;
      letter-spacing: 0.12em;
    }
    .logo-phrases {
      display: inline-grid;
      justify-content: start;
    }
  }
</style>
