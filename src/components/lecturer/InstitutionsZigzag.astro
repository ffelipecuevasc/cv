---
/*
 * Experiencia por institución (E80-I01, ADR-070): patrón «zigzag» (DESIGN.md 11.2) con una
 * franja temática (7.8) por institución, de la más reciente a la más antigua. Fondos `bg`,
 * `band` y `bg`; la franja del medio va en espejo. Cada franja tiene el id que usa el índice de
 * la cabecera (InstitutionStripe).
 * E200-I09 (ADR-117): el encabezado de la sección y la primera franja (IPLACEX) comparten una sola
 * capa del campo de puntos del hero (texture-dots y texture-halo), sin corte entre ambos; Duoc UC
 * lleva curvas de nivel (ladera) e INACAP su propio campo de puntos.
 */
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import InstitutionStripe from './InstitutionStripe.astro';
import { langFromLocale } from '../../i18n/lang';
import { getLecturerPage } from './lecturer-data';

const lang = langFromLocale(Astro.currentLocale);
const { institutions } = await getLecturerPage();
const [first, ...rest] = institutions.items;
if (!first) throw new Error('Experiencia por institución necesita al menos una institución');
// Fondo de cada franja después de la primera: band con curvas y bg con puntos, alternados.
const textureOf = (index: number) => (index % 2 === 1 ? 'contour' : 'dots');
---

<section class="institutions" aria-labelledby="institutions-title" data-institutions>
  <div class="dots-zone">
    <div class="texture-dots layer" aria-hidden="true"></div>
    <div class="texture-halo layer" aria-hidden="true"></div>
    <div class="intro">
      <Container>
        <SectionHeader
          kicker={institutions.kicker[lang]}
          title={institutions.title[lang]}
          id="institutions-title"
        />
      </Container>
    </div>
    <InstitutionStripe item={first} index={0} texture="grid" />
  </div>
  {rest.map((item, i) => (
    <InstitutionStripe item={item} index={i + 1} texture={textureOf(i + 1)} />
  ))}
</section>

<style>
  .intro {
    padding-top: 72px;
  }
  .institutions :global(section[id]) {
    scroll-margin-top: 96px;
  }
  /* Una sola capa de puntos detrás del encabezado y de la franja de IPLACEX (4.5). */
  .dots-zone {
    position: relative;
    isolation: isolate;
    background-color: var(--color-bg);
  }
  .layer {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  /* La franja pinta su propio fondo `bg`, que taparía la capa: aquí lo pone el envoltorio. */
  .dots-zone > :global(.tone-bg) {
    background-color: transparent;
  }
  @media (min-width: 48rem) {
    .intro {
      padding-top: 96px;
    }
  }
</style>
