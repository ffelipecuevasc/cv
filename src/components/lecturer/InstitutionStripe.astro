---
/*
 * Franja de una institución en «Experiencia por institución» (E80-I01, ADR-070; extraída de
 * InstitutionsZigzag en E200-I09, ADR-117, sin cambios de contenido). Rótulo: periodo; titular
 * (h3): nombre de la institución; contenido: foto (solo INACAP), texto con énfasis y «Ver más
 * información» a LinkedIn, externo y avisado. Las impares van en tono band y en espejo.
 * `texture` elige el fondo de ThemeStripe (ADR-114): IPLACEX va lisa (sus puntos los pone el
 * envoltorio del zigzag), Duoc UC con curvas (ladera) e INACAP con puntos.
 */
import { Image } from 'astro:assets';
import ContourLines from '../ui/ContourLines.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import ThemeStripe from '../ui/ThemeStripe.astro';
import { parseEmphasis } from '../home/hero-text';
import { langFromLocale } from '../../i18n/lang';
import { getLecturerPage } from './lecturer-data';

type Institution = Awaited<ReturnType<typeof getLecturerPage>>['institutions']['items'][number];

interface Props {
  item: Institution;
  index: number;
  texture: 'grid' | 'contour' | 'dots';
}

const { item, index, texture } = Astro.props;
const lang = langFromLocale(Astro.currentLocale);
const { institutions } = await getLecturerPage();
const odd = index % 2 === 1;
---

<ThemeStripe
  id={item.id}
  kicker={item.period[lang]}
  title={item.name}
  level={3}
  tone={odd ? 'band' : 'bg'}
  reverse={odd}
  mirror={odd}
  texture={texture}
>
  {texture === 'contour' && (
    <ContourLines slot="decor" pieces={[{ corner: 'top-left', shape: 'slope' }]} mask="none" />
  )}
  {item.photo && (
    <figure class="photo">
      <Image
        src={item.photo.image}
        alt={item.photo.alt[lang]}
        widths={[480, 800, 1200]}
        width={1200}
        height={800}
        sizes="(min-width: 1024px) 680px, 100vw"
        loading="lazy"
      />
      <figcaption>
        <span class="caption">{item.photo.caption[lang]}</span>
        <span class="note">{item.photo.note[lang]}</span>
      </figcaption>
    </figure>
  )}
  <p class="text">
    {parseEmphasis(item.text[lang]).map((part) =>
      part.strong ? <strong>{part.text}</strong> : part.text,
    )}
  </p>
  <p class="more">
    <ExternalLink href={institutions.moreInfoUrl} lang={lang}>
      {institutions.moreInfo[lang]}
      <span class="sr-only">: {item.shortName}</span>
    </ExternalLink>
  </p>
</ThemeStripe>

<style>
  .text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.7;
  }
  .text strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .more {
    margin: 20px 0 0;
    font-size: 15px;
  }
  /* AT-114: en `text`, 600 y subrayado (no `accent`: sobre `band` da 4,09:1 en claro). */
  .more :global(a) {
    min-height: 44px;
    color: var(--color-text);
    font-weight: 600;
  }
  .photo {
    margin: 0 0 24px;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.4;
  }
  .caption {
    color: var(--color-text);
    font-weight: 600;
  }
  .note {
    color: var(--color-text-soft);
  }
</style>
