---
/*
 * Documento de la política (E155-I01, ADR-087, composición A): índice con anclas y secciones con
 * h2. Desde 1.024 px el índice va a la izquierda, pegajoso bajo la barra (4 de 12 columnas, con el
 * texto en 8); bajo esa medida va arriba. Sin JavaScript. Texto informativo, no asesoría legal:
 * pendiente de revisión por un especialista (BL-08).
 */
import Container from '../ui/Container.astro';
import ExternalLink from '../ui/ExternalLink.astro';
import { langFromLocale } from '../../i18n/lang';
import { getPrivacyPage } from './privacy-data';

const lang = langFromLocale(Astro.currentLocale);
const { sections, indexLabel, indexTitle } = await getPrivacyPage();
---

<section class="privacy-document" aria-labelledby="privacy-title">
  <Container>
    <div class="layout">
      <nav class="index" aria-label={indexLabel[lang]}>
        <p class="index-title">{indexTitle[lang]}</p>
        <ol>
          {sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title[lang]}</a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="body">
        {sections.map((section) => (
          <section class="section" id={section.id} aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.title[lang]}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph[lang]}</p>
            ))}
            {section.items && (
              <ul class="items">
                {section.items.map((item) => (
                  <li>
                    <code>{item.key}</code>
                    <span>: {item.text[lang]}</span>
                  </li>
                ))}
              </ul>
            )}
            {section.after?.map((paragraph) => (
              <p>{paragraph[lang]}</p>
            ))}
            {section.links && (
              <ul class="links">
                {section.links.map((link) => (
                  <li>
                    {link.href.startsWith('mailto:') ? (
                      <a class="mail-link" href={link.href}>
                        {link.label[lang]}
                      </a>
                    ) : (
                      <ExternalLink href={link.href} {lang}>
                        {link.label[lang]}
                      </ExternalLink>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </div>
  </Container>
</section>

<style>
  .privacy-document {
    padding-block: 8px 80px;
    background-color: var(--color-bg);
  }
  .layout {
    display: grid;
    gap: 40px;
  }
  .index-title {
    margin: 0;
    color: var(--color-kicker);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .index ol {
    display: grid;
    margin: 12px 0 0;
    padding: 0;
    border-inline-start: 1px solid var(--color-border);
    list-style: none;
  }
  .index a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 6px 16px;
    margin-inline-start: -1px;
    border-inline-start: 1px solid transparent;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.35;
    text-decoration: none;
    transition-property: color, border-color;
    transition-duration: var(--duration-base);
    transition-timing-function: ease;
  }
  .index a:hover {
    border-inline-start-color: var(--color-vibrant);
    color: var(--color-text);
  }
  .section {
    position: relative;
    /* El html ya reserva la barra (scroll-padding-top: 76px): con 8 px la ancla cae a 84 px. */
    scroll-margin-top: 8px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border-strong);
  }
  .section + .section {
    margin-top: 40px;
  }
  /* Tramo dorado de 48 px sobre la regla de 1 px (patrón de lista con regla superior, 11.2). */
  .section::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-gold), var(--color-vibrant));
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  p {
    margin: 16px 0 0;
    max-width: 62ch;
    color: var(--color-text-muted);
    font-size: 1.08rem;
    font-weight: 300;
    line-height: 1.75;
  }
  .items {
    display: grid;
    gap: 10px;
    margin: 16px 0 0;
    padding: 0;
    max-width: 62ch;
    color: var(--color-text-muted);
    font-size: 1.08rem;
    font-weight: 300;
    line-height: 1.6;
    list-style: none;
  }
  code {
    padding: 1px 8px;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.92em;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .links {
    display: grid;
    gap: 4px;
    margin: 16px 0 0;
    padding: 0;
    font-size: 15px;
    list-style: none;
  }
  .links :global(a),
  .mail-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mail-link:hover {
    color: var(--color-heading);
  }
  @media (min-width: 40rem) {
    .index ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 48rem) {
    .privacy-document {
      padding-block: 8px 96px;
    }
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 48px;
      align-items: start;
    }
    .index {
      position: sticky;
      top: 100px;
      grid-column: span 4;
    }
    .index ol {
      grid-template-columns: 1fr;
    }
    .body {
      grid-column: span 8;
    }
  }
</style>
