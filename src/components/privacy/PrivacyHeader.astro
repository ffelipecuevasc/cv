---
/*
 * Cabecera de la política de privacidad (E155-I01, ADR-087): el único <h1>, con rótulo y bajada,
 * alineada a la izquierda sobre `bg`, más la ficha de versión y vigencia (la versión sale de la
 * constante única) y el aviso de que el texto no es asesoría legal. Sin JavaScript.
 */
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { langFromLocale } from '../../i18n/lang';
import { PRIVACY_POLICY_VERSION, formatPolicyDate, getPrivacyPage } from './privacy-data';

const lang = langFromLocale(Astro.currentLocale);
const { header } = await getPrivacyPage();
---

<div class="privacy-header">
  <Container>
    <SectionHeader
      level={1}
      kicker={header.kicker[lang]}
      title={header.title[lang]}
      lead={header.lead[lang]}
      id="privacy-title"
    />
    <dl class="meta">
      <div>
        <dt>{header.version[lang]}</dt>
        <dd data-policy-version>{PRIVACY_POLICY_VERSION}</dd>
      </div>
      <div>
        <dt>{header.effective[lang]}</dt>
        <dd>
          <time datetime={PRIVACY_POLICY_VERSION}>{formatPolicyDate(lang)}</time>
        </dd>
      </div>
    </dl>
    <p class="disclaimer">{header.disclaimer[lang]}</p>
  </Container>
</div>

<style>
  .privacy-header {
    padding-block: 64px 40px;
    background-color: var(--color-bg);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    margin: 32px 0 0;
  }
  dt {
    color: var(--color-text-soft);
    font-size: 12.5px;
    font-weight: 400;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  dd {
    margin: 6px 0 0;
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.03em;
    line-height: 1.3;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .disclaimer {
    margin: 20px 0 0;
    max-width: 62ch;
    color: var(--color-text-soft);
    font-size: 14px;
    line-height: 1.5;
  }
  @media (min-width: 48rem) {
    .privacy-header {
      padding-block: 80px 48px;
    }
  }
</style>
