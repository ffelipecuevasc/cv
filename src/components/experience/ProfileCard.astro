---
/*
 * Tarjeta de perfil de Experiencia (E60-I01, DESIGN.md 7.6 y 11.5, ADR-065). Las tres tarjetas
 * son iguales: foto, rótulo, título, instituciones, periodo y modalidad, texto, etiquetas y
 * enlaces. Los enlaces van al pie, alineados abajo aunque el texto mida distinto, y llevan
 * uno o dos botones: con dos, el primero es el principal y el segundo es secundario.
 * Todo texto llega ya en el idioma de la página. Sin JavaScript.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
import Button from '../ui/Button.astro';
import { parseEmphasis } from '../home/hero-text';

export interface ProfileItem {
  id: string;
  image: ImageMetadata;
  imageAlt: string;
  kicker: string;
  title: string;
  institutions: string;
  paragraph: string;
  tags: string[];
  /** Periodo y modalidad en una línea: "2013 - Actualidad · Modalidad semipresencial". */
  meta: string;
  links: { href: string; text: string; label?: string }[];
  /** Carga prioritaria de la foto (la primera, que puede ser el LCP). */
  eager?: boolean;
}

interface Props {
  item: ProfileItem;
}

const { item } = Astro.props;
const paragraph = parseEmphasis(item.paragraph);
---

<Card class="profile-card">
  <div class="photo">
    <Image
      src={item.image}
      alt={item.imageAlt}
      width={640}
      height={427}
      widths={[320, 640]}
      sizes="(min-width: 1280px) 310px, (min-width: 1024px) 25vw, (min-width: 768px) calc(100vw - 148px), calc(100vw - 100px)"
      loading={item.eager ? 'eager' : 'lazy'}
      fetchpriority={item.eager ? 'high' : undefined}
      decoding="async"
    />
  </div>
  <p class="kicker">{item.kicker}</p>
  <h2 class="title">{item.title}</h2>
  <p class="institutions">{item.institutions}</p>
  <p class="meta">{item.meta}</p>
  <p class="paragraph">
    {paragraph.map((part) => (part.strong ? <strong>{part.text}</strong> : part.text))}
  </p>
  <ul class="tags">
    {item.tags.map((tag) => (
      <li>
        <Tag>{tag}</Tag>
      </li>
    ))}
  </ul>
  <div class="actions">
    {item.links.map((link, index) => (
      <Button
        href={link.href}
        variant={index === 0 ? 'primary' : 'secondary'}
        label={link.label}
        full
      >
        {link.text}
      </Button>
    ))}
  </div>
</Card>

<style>
  /* La raíz de `Card` es de otro componente: su clase es global. */
  :global(.profile-card) {
    display: flex;
    flex-direction: column;
  }
  p,
  ul {
    margin: 0;
  }
  .photo {
    aspect-ratio: 3 / 2;
    margin-bottom: 24px;
    overflow: hidden;
    background-color: var(--color-bg-alt);
    box-shadow: 0 0 0 1px var(--color-border);
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kicker {
    color: var(--color-kicker);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .title {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .institutions {
    margin-top: 8px;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .meta {
    margin-top: 4px;
    color: var(--color-text-soft);
    font-size: 13px;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .paragraph {
    margin-top: 16px;
    color: var(--color-text-muted);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
  }
  .paragraph strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    padding: 0;
    list-style: none;
  }
  /* Los botones van al pie: alineados abajo aunque el texto de cada tarjeta mida distinto. */
  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
    padding-top: 28px;
  }
</style>
