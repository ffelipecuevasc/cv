---
/*
 * Línea de tiempo de Experiencia (E200-I07, ADR-115, que sustituye en parte a ADR-066): los 3
 * hitos en orden cronológico (2011, 2013 y 2023) como tarjetas sobre una línea horizontal desde
 * 1.024 px y vertical bajo esa medida. Cada hito toma el periodo y la modalidad de la tarjeta de
 * su perfil (AT-081) y muestra «Desde {año}», título, instituciones, modalidad y estado, con el
 * año de inicio grande y translúcido como fondo tipográfico.
 *
 * La línea, el tramo punteado, los nodos, los tallos, los años, la flecha, el punto vivo y «Hoy»
 * son decorativos (aria-hidden): la lista conserva sus 3 elementos legibles en orden. Sin
 * JavaScript. El único movimiento es el pulso del punto vivo, que con movimiento reducido queda
 * como un halo quieto (excepción acotada de ADR-115 a DESIGN.md 8). El campo de puntos lo pone
 * ExperienceIntro, que envuelve el encabezado y esta sección.
 */
import { getEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { langFromLocale } from '../../i18n/lang';

const lang = langFromLocale(Astro.currentLocale);
const page = (await getEntry('experiencePage', 'page'))?.data;
if (!page) throw new Error('Falta src/content/experience/page.json');
const { timeline, profiles } = page;

// Periodo «2011 - Actualidad»: año de inicio de 4 dígitos, guion y estado.
const PERIOD = /^(\d{4})\s*-\s*(\S.*)$/;

// Cada hito sale de su perfil (AT-081): año de inicio, estado y modalidad. Falla al compilar si
// el perfil no existe o si el periodo no empieza con un año de 4 dígitos.
const milestones = timeline.items
  .map((item) => {
    const profile = profiles.find((candidate) => candidate.id === item.profile);
    if (!profile) throw new Error(`El hito «${item.title.es}» apunta a un perfil inexistente`);
    const match = PERIOD.exec(profile.period[lang].trim());
    if (!match) {
      throw new Error(
        `El periodo «${profile.period[lang]}» del perfil «${profile.id}» debe empezar con un año de 4 dígitos («2011 - Actualidad»)`,
      );
    }
    return {
      ...item,
      year: match[1],
      status: match[2],
      modality: profile.modality[lang],
    };
  })
  .sort((a, b) => Number(a.year) - Number(b.year));
---

<section class="timeline" aria-label={timeline.label[lang]}>
  <Container>
    <div class="track">
      <div class="rail" aria-hidden="true">
        <span class="rail-lead"></span>
        <span class="rail-line"></span>
        <span class="rail-end">
          <Icon name="arrow-right" size={18} class="rail-arrow" />
          <span class="live"></span>
          <span class="today">{timeline.today[lang]}</span>
        </span>
      </div>
      <ol class="list" data-timeline>
        {milestones.map((item) => (
          <li class="milestone" data-start-year={item.year}>
            <span class="node-year" aria-hidden="true">
              {item.year}
            </span>
            <span class="node" aria-hidden="true" />
            <span class="stem" aria-hidden="true" />
            <div class="card">
              <span class="watermark" aria-hidden="true">
                {item.year}
              </span>
              <div class="head">
                <span class="icon">
                  <Icon name={item.icon} size={22} />
                </span>
                <p class="since">
                  {timeline.since[lang]} {item.year}
                </p>
              </div>
              <p class="title">{item.title[lang]}</p>
              <p class="institutions">{item.institutions}</p>
              <p class="meta">
                {item.modality} · {item.status}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</section>

<style>
  /*
   * Medidas de la línea (decorativas). --node-x es el centro del ícono de la tarjeta medido
   * desde el borde izquierdo del hito: borde de 1 px + relleno + mitad de la caja de 40 px.
   */
  .timeline {
    --card-pad: 20px;
    --icon-box: 40px;
    --node: 14px;
    --year-row: 24px;
    --stem: 0px;
    --rail-x: 7px;
    --gutter: 32px;
    --rail-gradient: linear-gradient(var(--color-gold), var(--color-vibrant));
    position: relative;
    padding-block: 0 64px;
  }
  @media (min-width: 48rem) {
    .timeline {
      --card-pad: 24px;
      padding-block: 0 80px;
    }
  }

  .track {
    position: relative;
    padding-bottom: 52px;
  }
  .list {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Línea (bajo 1.024 px: vertical a la izquierda) ---------- */
  .rail {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .rail-lead,
  .rail-line {
    position: absolute;
    left: calc(var(--rail-x) - 1px);
    width: 2px;
  }
  /* Tramo punteado antes del primer hito. */
  .rail-lead {
    top: -28px;
    height: calc(28px + var(--year-row) / 2);
    background: repeating-linear-gradient(
      to bottom,
      var(--color-border-strong) 0 3px,
      transparent 3px 7px
    );
  }
  /* Línea de 2 px con el degradado gold → vibrant desde el primer hito hasta el final. */
  .rail-line {
    top: calc(var(--year-row) / 2);
    bottom: 40px;
    background: var(--rail-gradient);
  }
  .rail-end {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    color: var(--color-accent);
  }
  .rail-end :global(.rail-arrow) {
    margin-left: calc(var(--rail-x) - 9px);
    rotate: 90deg;
  }
  .live {
    position: relative;
    width: 10px;
    height: 10px;
    margin-left: calc(var(--rail-x) - 5px);
    border-radius: 9999px;
    background-color: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 22%, transparent);
  }
  .today {
    position: absolute;
    left: calc(var(--rail-x) + 14px);
    bottom: -3px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--color-text-soft);
    white-space: nowrap;
  }

  /* ---------- Hito ---------- */
  .milestone {
    position: relative;
    padding-left: var(--gutter);
    padding-top: calc(var(--year-row) + var(--stem));
    min-width: 0;
  }
  .node-year {
    position: absolute;
    top: 0;
    left: var(--gutter);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: var(--year-row);
    color: var(--color-text-soft);
    font-variant-numeric: tabular-nums lining-nums;
  }
  /* Nodo: anillo dorado y núcleo accent (DESIGN.md 1.3: el círculo se admite en indicadores). */
  .node {
    position: absolute;
    top: calc((var(--year-row) - var(--node)) / 2);
    left: calc(var(--rail-x) - var(--node) / 2);
    width: var(--node);
    height: var(--node);
    border-radius: 9999px;
    background-color: var(--color-accent);
    box-shadow:
      0 0 0 3px var(--color-bg),
      0 0 0 4.5px var(--color-gold);
  }
  .stem {
    display: none;
  }

  /* ---------- Tarjeta ---------- */
  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: 100%;
    padding: var(--card-pad) var(--card-pad) calc(var(--card-pad) + 44px);
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }
  .card p {
    margin: 0;
  }
  /* Año de inicio grande y translúcido, cortado por el borde inferior derecho (decorativo). */
  .watermark {
    position: absolute;
    right: -0.04em;
    bottom: -0.26em;
    z-index: -1;
    font-family: var(--font-display);
    font-size: 5.25rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1;
    color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    font-variant-numeric: tabular-nums lining-nums;
    user-select: none;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .icon {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--icon-box);
    height: var(--icon-box);
    border-radius: 9999px;
    background-color: var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-border-strong);
    color: var(--color-icon);
  }
  .since {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--timeline-since);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-heading);
    text-wrap: balance;
  }
  .institutions {
    margin-top: 6px;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .meta {
    margin-top: 12px;
    color: var(--color-text-soft);
    font-size: 13px;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* «Desde 2011»: gold-deep en claro (6,25:1 sobre blanco) y gold en oscuro. */
  .timeline {
    --timeline-since: var(--color-gold-deep);
  }
  :global(.dark) .timeline {
    --timeline-since: var(--color-gold);
  }

  /* ---------- Desde 1.024 px: línea horizontal sobre 3 columnas ---------- */
  @media (min-width: 64rem) {
    .timeline {
      --node: 16px;
      --year-row: 28px;
      --stem: 44px;
      --gutter: 0px;
    }
    .track {
      padding-bottom: 0;
    }
    .list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }
    /* Centro del nodo, del tallo y del año: el del ícono de la tarjeta. */
    .milestone {
      --node-x: calc(1px + var(--card-pad) + var(--icon-box) / 2);
    }
    .rail-lead,
    .rail-line {
      top: calc(var(--year-row) / 2 - 1px);
      height: 2px;
      width: auto;
    }
    .rail-lead {
      left: -40px;
      width: calc(40px + 1px + var(--card-pad) + var(--icon-box) / 2);
      bottom: auto;
      background: repeating-linear-gradient(
        to right,
        var(--color-border-strong) 0 3px,
        transparent 3px 7px
      );
    }
    .rail-line {
      left: calc(1px + var(--card-pad) + var(--icon-box) / 2);
      right: 30px;
      bottom: auto;
      background: linear-gradient(to right, var(--color-gold), var(--color-vibrant));
    }
    .rail-end {
      top: calc(var(--year-row) / 2 - 9px);
      right: 0;
      left: auto;
      bottom: auto;
      flex-direction: row;
      align-items: center;
      gap: 2px;
    }
    .rail-end :global(.rail-arrow) {
      margin-left: 0;
      rotate: none;
    }
    .live {
      margin-left: 0;
    }
    .today {
      left: auto;
      right: -2px;
      bottom: calc(100% + 2px);
    }
    .node-year {
      left: var(--node-x);
      top: calc(-1 * var(--year-row) + 2px);
      translate: -50% 0;
    }
    .node {
      left: calc(var(--node-x) - var(--node) / 2);
    }
    .stem {
      position: absolute;
      top: calc((var(--year-row) + var(--node)) / 2 + 4.5px);
      left: calc(var(--node-x) - 0.5px);
      display: block;
      width: 1px;
      height: calc(var(--year-row) / 2 + var(--stem) - var(--node) / 2 - 4.5px);
      background: linear-gradient(var(--color-gold), var(--color-vibrant));
    }
    /* Espacio arriba para los años y el rótulo «Hoy». */
    .track {
      padding-top: var(--year-row);
    }
    .rail {
      top: var(--year-row);
    }
  }

  /* Pulso suave e infinito del punto vivo: única animación en bucle de la página (ADR-115). */
  @media (prefers-reduced-motion: no-preference) {
    .live::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 9999px;
      background-color: var(--color-accent);
      animation: timeline-pulse 2.4s var(--ease-out-soft) infinite;
    }
  }
  @keyframes timeline-pulse {
    0% {
      opacity: 0.45;
      scale: 1;
    }
    70%,
    100% {
      opacity: 0;
      scale: 2.6;
    }
  }
</style>
