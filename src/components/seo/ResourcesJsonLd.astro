---
/*
 * Datos estructurados de una ruta de aprendizaje (E130-I02, ADR-082): un `Course` con el mismo
 * esquema que main usaba para sus rutas (proveedor e instructor = Person de la portada por @id,
 * CourseInstance en línea de 8 horas). Desde E200-I14 (ADR-122) va en la página de su ruta, no en
 * Recursos. `inLanguage` es «es» en ambas versiones porque los materiales están en español (AT-034).
 */
import JsonLd from './JsonLd.astro';
import { entityIds } from './structured-data';
import { langFromLocale } from '../../i18n/lang';
import { getRoute, learningPathKey } from '../../i18n/routes';
import type { RouteWithStages } from '../resources/resources-data';

interface Props {
  route: RouteWithStages['route'];
}

const lang = langFromLocale(Astro.currentLocale);
const site = Astro.site as URL;
const { route } = Astro.props;
const page = new URL(getRoute(learningPathKey(route.id), lang), site);
const person = { '@id': entityIds(site).person };

const course = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': `${page.href}#curso`,
  name: route.title[lang],
  description: route.summary[lang],
  url: page.href,
  inLanguage: 'es',
  teaches: route.facts[0].text[lang],
  coursePrerequisites: route.facts[1].text[lang],
  isAccessibleForFree: true,
  provider: person,
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: 'PT8H',
    instructor: person,
  },
};
---

<JsonLd data={course} />
